<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <!-- 固定逻辑源，不继承开发机上的 NuGet 配置。
         没有这个文件时 restore 用机器上的源列表 —— 本机实测有两个：nuget.org 与
         Visual Studio 自带的本地目录。只有一个零依赖包时无所谓，Avalonia 带来 30 个
         传递依赖后，不同开发机会解析出不同结果。

         <clear /> 清掉的是**继承来的源定义**，不改变实际网络路径：
         本机访问 api.nuget.org 仍会被 302 到镜像，那是网络层的事，与本文件无关
         （也因此 localhost 之外的镜像不需要在这里登记）。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- 仓库自身不发布包，因此不需要包输出源之外的任何配置。 -->

</configuration>
