<Project>

  <PropertyGroup>

    <Version>0.39.2</Version>

    <Company>Simdsoft Limited</Company>
    <Copyright>Copyright &#169; 2026 Simdsoft Limited</Copyright>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
      
  </PropertyGroup>

  <PropertyGroup>
    <RollForward>Major</RollForward>
    <!-- API-key-only Gemini usage does not need Google OAuth ADC reflection rooting when
         PublishTrimmed or PublishAot is enabled on executable projects importing Google.GenAI.targets. -->
    <GoogleGenAIRootAuthAssemblies>false</GoogleGenAIRootAuthAssemblies>
  </PropertyGroup>

</Project>
