<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The Avalonia counterpart of WPF's x:Key-named styles (Muted / Card / Primary / Quiet) is the
    **style class**: controls carry Classes="muted" / "card" / "primary" / "quiet".
    Class styles layer on top of ControlTheme, so WPF's
    `BasedOn="{StaticResource {x:Type Button}}"` is no longer needed — both styles take effect.

    The other part of this file is the template-less styles moved over from App.xaml
    (the DataGrid family's property settings).
  -->

  <Styles.Resources>

    <!-- Font fallback chain. The WPF version hard-coded "Segoe UI, Microsoft YaHei UI"; on macOS / Linux
         the first of these does not exist, so Chinese fell back to whatever the system provides. Here we
         give one common font per platform, all ranked before the generic family. -->
    <FontFamily x:Key="Hub.Font.Ui">Segoe UI, Microsoft YaHei UI, PingFang SC, Hiragino Sans GB, Source Han Sans SC, Noto Sans CJK SC, DejaVu Sans, sans-serif</FontFamily>
    <FontFamily x:Key="Hub.Font.Mono">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, Noto Sans Mono CJK SC, monospace</FontFamily>
    <Template x:Key="Hub.MenuTickTemplate">
      <Path Width="11" Height="11" Stretch="Uniform" Data="{StaticResource Hub.Icon.MenuTick}"
            Stroke="{DynamicResource Hub.TextSecondary}" StrokeThickness="1.4"
            StrokeLineCap="Round" StrokeJoin="Round" />
    </Template>

  </Styles.Resources>

  <!-- ==================== Window and body text ==================== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Hub.Font.Ui}" />
    <Setter Property="Background" Value="{DynamicResource Hub.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>

  <!-- The WPF version's TextBlock default style (foreground + vertical centering) is kept as-is here.
         Note this is global: its foreground overrides colors inherited from the parent, matching WPF's behavior. -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- WPF's Style x:Key="Muted" -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Inline error copy inside a card (e.g. a failed update download). Same ink weight of the danger
       hue as the destructive button, so it reads as a warning without becoming a filled block. It
       shares muted's metrics deliberately: a status line that flips to an error must not change size
       or re-wrap the card. Callers swap .muted for .danger, never use both. -->
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Monospace font for the activity log (WPF inlined FontFamily="Consolas") -->
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource Hub.Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ==================== Containers ==================== -->
  <!-- WPF's Style x:Key="Card" -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- ==================== Drawn window chrome ====================
       The caption plates, shared by the shell's title bar and by every internal dialog's drawn header
       (Views/HubDialogChrome.cs). They live here rather than in MainWindow.axaml because a dialog has to wear
       the same bar the shell does — a native frame on a popup next to a self-drawn title bar reads as somebody
       else's app. They keep the platform's own proportions - 46x32 plates, flush to the window's top-right
       corner, square corners - so the bar reads as a title bar and not as an app toolbar. The close plate is the
       one that turns red, which is the only place in this app that colour is allowed to mean "destructive". -->
  <Style Selector="Button.window-control">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-control:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hub.WindowButtonHover}" />
  </Style>
  <!-- The maximize plate's own hover, driven from the non-client mouse messages rather than from
       :pointerover: the Snap Layouts hit test above makes that point non-client, so the client hover never
       fires there (see TitleBarSnapHook). Same brush as the rule above, so the three plates read identically. -->
  <Style Selector="Button.window-control.nchover">
    <Setter Property="Background" Value="{DynamicResource Hub.WindowButtonHover}" />
  </Style>
  <!-- And its pressed plate, for the same reason and from the same hook: :pressed cannot fire on a point the
       system hands to the window as a non-client button. Same brush as the rule below so the plate darkens like
       the two beside it. -->
  <Style Selector="Button.window-control.ncpressed">
    <Setter Property="Background" Value="{DynamicResource Hub.WindowButtonPressed}" />
  </Style>
  <Style Selector="Button.window-control:pressed">
    <Setter Property="Background" Value="{DynamicResource Hub.WindowButtonPressed}" />
  </Style>
  <Style Selector="Button.window-control Path.glyph">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.window-control:pointerover Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>
  <Style Selector="Button.window-control.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hub.WindowButtonCloseHover}" />
  </Style>
  <Style Selector="Button.window-control.close:pressed">
    <Setter Property="Background" Value="{DynamicResource Hub.WindowButtonCloseHover}" />
  </Style>
  <Style Selector="Button.window-control.close Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
  </Style>
  <Style Selector="Button.window-control.close:pointerover Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource Hub.WindowButtonCloseForeground}" />
  </Style>
  <Style Selector="Button.window-control.close:pressed Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource Hub.WindowButtonCloseForeground}" />
  </Style>

  <!-- The 32px header an internal dialog draws for itself. Same plate colour as the shell's bar, plus the
       hairline the shell's bar does not need: the shell's bar sits above the page that belongs to it, while a
       dialog's body is a separate surface and the two would run into each other. -->
  <Style Selector="Border.dialog-chrome">
    <Setter Property="Background" Value="{DynamicResource Hub.TitleBarBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.TitleBarBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.dialog-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="Margin" Value="14,0,0,0" />
  </Style>

  <!-- ==================== Button variants ==================== -->
  <!-- Smaller action plates without changing typography, colour, or content alignment.
       MinHeight leaves room for platform fonts; centering prevents a multiline neighbour stretching the plate. -->
  <Style Selector="Button.compact">
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- WPF's Style x:Key="Primary" -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- WPF's Style x:Key="Quiet" -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
  </Style>

  <!-- Compact actions in the Changes header. The secondary action stays quiet beside the save plate. -->
  <Style Selector="Button.inspector-edit-action">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.inspector-edit-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>
  <Style Selector="Button.inspector-edit-action.save">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>
  <Style Selector="Button.inspector-edit-action.save:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
  </Style>

  <!-- A link, for the one destination the About box points at. A Button rather than a TextBlock with a pointer
       handler, so focus, Enter/Space and the hand cursor come with it; quiet enough that the row reads as text
       until the pointer is on it. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.Accent}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Hub.AccentBorder}" />
  </Style>

  <!-- A model row is a small outlined card so the list reads as a list. Surface fill + hairline border;
       hover only lifts the fill. -->
  <Style Selector="Border.model-row">
    <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.model-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
  </Style>

  <!-- The provider card: outlined, slightly darker than the model rows inside it. -->
  <Style Selector="Border.provider-card">
    <Setter Property="Background" Value="{DynamicResource Hub.ProviderSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!-- The model-list collapse header (SettingsPage) no longer relies on a "quiet" class here: Fluent's
       ToggleButton paints its :checked accent slab from inside its own template, which a Background style
       setter cannot reach. It is handled by the HubCollapseHeader ControlTheme in HubControls.axaml instead. -->

  <!-- An icon cluster that stays quiet until the row it lives on is hovered (pencil / trash on a provider
       header). Opacity is the reveal; the icons are always in the tree so tab order and hit-testing survive.
       The reveal is driven by the parent row's pointerover, not the cluster's own, so the icons appear when
       the eye is anywhere on the row. -->
  <Style Selector="Grid.provider-row StackPanel.reveal">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Grid.provider-row:pointerover StackPanel.reveal">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.provider-row StackPanel.reveal">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.provider-row:pointerover StackPanel.reveal">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Added in P4. The WPF version had no "dangerous action" button variant: there MessageBoxImage.Warning/Error
       only swapped the icon, and the confirm button of uninstall / delete confirmation dialogs looked exactly
       like a normal confirm button. HubDialog adds this tier as a button variant. -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Hub.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Danger}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    Added in P6: two orthogonal affordances that say what a click will do **before** it happens.
    Before this, every page button looked identical and the only way to learn that Uninstall asked
    first while Repair went straight ahead was to click them and find out.

      more         a trailing ellipsis. The universal convention: the click opens a dialog or a
                   picker first, so the button does not act yet. Never decoration, and never applied
                   to a button that really does act on click.
      destructive  acts immediately and either is not undoable or has a wide blast radius. Kept one
                   weight below .danger on purpose: .danger fills the whole button and belongs to the
                   confirm key of a dialog, where the warning should dominate. A page button that
                   shouts that loudly would compete with the action bar's primary button.

    The two are mutually exclusive in practice: an action that already has a confirmation dialog takes
    .more and lets that dialog's danger styled confirm key carry the warning, so .destructive stays
    reserved for what runs without asking.

    The ellipsis is switched on by selector specificity, not by a value in the template: the
    default-hide rule below and the .more rule come from the same source, and a class selector simply
    outranks a type selector there. (HubControls.axaml explains why the part carries no IsVisible.)
  -->
  <Style Selector="Button /template/ TextBlock#PART_MoreAffordance">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.more /template/ TextBlock#PART_MoreAffordance">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="Button.destructive">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.DangerBorder}" />
  </Style>
  <!-- Without this the shared hover rule would repaint a destructive button's frame in the accent blue
       on hover, which reads as if the warning had been withdrawn. -->
  <Style Selector="Button.destructive:pointerover /template/ Border#Frame">
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.DangerText}" />
  </Style>

  <!-- ==================== Inputs ==================== -->
  <!-- The WPF PasswordBox style. Avalonia has no PasswordBox: password box = TextBox + PasswordChar,
         so this is just a class, not a template. -->
  <Style Selector="TextBox.password">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
  </Style>

  <!-- ==================== DataGrid family ====================
       The WPF version wrote one style each for DataGrid / DataGridColumnHeader / DataGridCell / DataGridRow
       in App.xaml. Here we only override properties and state colors, **without replacing DataGrid's own template**:
       DataGrid's cell/row template parts cover more than a hand-written template could, and stability matters
       even more for the 35 references migrated in P5.

       Differences from WPF (Avalonia's DataGrid has no corresponding property, so they cannot be ported verbatim):
         RowHeight / ColumnHeaderHeight → use the row's MinHeight instead (see below)
         AlternatingRowBackground (zebra rows) → no corresponding property, missing for now
         SelectionUnit / CanUserResizeRows → no corresponding property; default behavior is already close -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Hub.GridSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="RowBackground" Value="{DynamicResource Hub.GridSurface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Hub.GridHeader}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <!-- WPF's `FocusVisualStyle="{x:Null}"` is FocusAdorner in Avalonia. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="56" />
  </Style>

  <!-- Hover and selection are both painted on Rectangle#BackgroundRectangle in the row template
       (verified against Avalonia's DataGrid Fluent theme), so /template/ is used to target that part,
       and the theme-provided opacity is explicitly overridden. -->
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Hub.RowHover}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Hub.RowSelected}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- Keep keyboard focus on the selected row without the DataGrid's bright per-cell focus frame. -->
  <Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Fluent's built-in checkbox and radio menu items use the same mark as Hub's custom menu rows. -->
  <Style Selector="MenuItem:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="Content" Value="{StaticResource Hub.MenuTickTemplate}" />
  </Style>
  <Style Selector="MenuItem:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="Content" Value="{StaticResource Hub.MenuTickTemplate}" />
  </Style>

  <!-- A caption row inside a menu — the section a set of choices belongs to. It is quiet, short, and never a
       keyboard stop, so it reads as a heading rather than as an answer that answers nothing. Its left inset
       matches a glyph-less MenuRow title, which keeps the caption over the words under it. -->
  <Style Selector="MenuItem.menu-caption">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="27,8,12,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
