<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Semantic color vocabulary. The WPF version scattered these values as literals across the 18
    ControlTemplates in App.xaml (#1E1E1E / #E4E4E4 / #A8A8A8 …), with the same meaning written as
    different near-matching colors in different controls. Here each meaning appears exactly once;
    the control layer only references names, never writes literals.

    Theme variants are expressed with ThemeDictionaries: which variant the app runs under is decided
    by RequestedThemeVariant, and switching variants at runtime makes all DynamicResource references
    re-resolve automatically. The WPF version only had the dark theme.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">

      <SolidColorBrush x:Key="Hub.Background" Color="#1A1C21" />
      <SolidColorBrush x:Key="Hub.Surface" Color="#262A33" />
      <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#20232A" />
      <!-- The spine: sidebar and inspector column. In dark it sits *below* the reading page so the page
           reads as the forward surface and the spine recedes; in light it is a touch darker than the page,
           the macOS / ChatGPT convention. Separate from SurfaceAlt (the composer/log card) on purpose. -->
      <SolidColorBrush x:Key="Hub.SurfaceChrome" Color="#14161A" />
      <SolidColorBrush x:Key="Hub.SurfaceRaised" Color="#2F3440" />
      <SolidColorBrush x:Key="Hub.SurfaceSunken" Color="#16181D" />
      <SolidColorBrush x:Key="Hub.ProviderSurface" Color="#1E2128" />
      <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#2C313C" />
      <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#333A47" />
      <SolidColorBrush x:Key="Hub.PopupSurface" Color="#232730" />

      <SolidColorBrush x:Key="Hub.Border" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="Hub.BorderSubtle" Color="#16FFFFFF" />
      <SolidColorBrush x:Key="Hub.BorderStrong" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="Hub.BorderHover" Color="#5C95E6" />
      <SolidColorBrush x:Key="Hub.BorderFocus" Color="#4A85D8" />

      <SolidColorBrush x:Key="Hub.TextPrimary" Color="#ECEFF4" />
      <!-- The reading rung: the ink a body of prose is read in, one step below the primary that chrome,
           headings and icons use. Primary was picked for labels and controls, while prose and inline code
           take this rung so headings stay the brightest thing on the page. It clears WCAG AAA (7:1) on
           Background, SurfaceRaised, and SurfaceSunken. Headings deliberately keep Hub.TextPrimary — that
           difference is the reading hierarchy, so do not collapse the two rungs into one. -->
      <SolidColorBrush x:Key="Hub.TextBody" Color="#CFD4DE" />
      <SolidColorBrush x:Key="Hub.TextSecondary" Color="#9BA3B4" />
      <SolidColorBrush x:Key="Hub.TextTertiary" Color="#757E91" />
      <SolidColorBrush x:Key="Hub.TextDisabled" Color="#5E6678" />
      <SolidColorBrush x:Key="Hub.TextOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Accent" Color="#2A64B8" />
      <SolidColorBrush x:Key="Hub.AccentBorder" Color="#3B76C9" />
      <SolidColorBrush x:Key="Hub.AccentSoft" Color="#2F6BC2" />
      <SolidColorBrush x:Key="Hub.AccentSoftBorder" Color="#4580D4" />
      <SolidColorBrush x:Key="Hub.Link" Color="#72A8F0" />
      <SolidColorBrush x:Key="Hub.LinkHover" Color="#9BC3F8" />

      <!-- Text selection on the reading surfaces (chat Markdown and the inspector's plan tab). A translucent
           accent rather than an opaque plate, so the ink under it keeps its own colour and a bold or code run
           stays legible the way it does in the reference shells. Two tokens because the inline code chip paints
           an opaque surface of its own — a translucent brush set on the chip would composite against the
           selection band already beneath it and come out darker than the band around it, so Hub.SelectionChip
           is that same mix over Hub.SurfaceRaised, worked out here once instead of at paint time. The band
           itself is drawn by the library inside CTextBlock.Render, which fills it with SelectionBrush and falls
           back to Brushes.Cyan when no brush is set — that cyan is what the setter in HubMarkdownStyles
           replaces. -->
      <SolidColorBrush x:Key="Hub.Selection" Color="#663675D1" />
      <SolidColorBrush x:Key="Hub.CodeSelection" Color="#2A3B52" />
      <SolidColorBrush x:Key="Hub.SelectionChip" Color="#335382" />

      <SolidColorBrush x:Key="Hub.Success" Color="#5AD2A2" />
      <SolidColorBrush x:Key="Hub.StatusWorking" Color="#FFD166" />
      <!-- Success split the way Danger is: Hub.Success is a fill (the context meter's bar), Hub.SuccessText is the
           same hue used as ink. On dark the fill colour already reads as ink (>8:1 on Hub.SurfaceAlt) — so the
           pair holds one value here; the Light dictionary is where it has to differ. -->
      <SolidColorBrush x:Key="Hub.SuccessText" Color="#5AD2A2" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBackground" Color="#2E2614" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeForeground" Color="#F5D076" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBorder" Color="#59471E" />
      <SolidColorBrush x:Key="Hub.Danger" Color="#F28B9E" />
      <!-- Danger split in two weights. Hub.Danger is a fill: on a dark page it is a bright block, which is
           why only HubDialog's confirm key uses it. Hub.DangerText is the same hue used as ink, and
           Hub.DangerBorder is that hue mixed into the surface, so a page button can be marked
           consequential without shouting over the action bar's primary button. -->
      <SolidColorBrush x:Key="Hub.WarningText" Color="#FFA45B" />
      <SolidColorBrush x:Key="Hub.LogWarning" Color="#FFD166" />
      <SolidColorBrush x:Key="Hub.DangerText" Color="#F28B9E" />
      <SolidColorBrush x:Key="Hub.DangerBorder" Color="#7A4652" />

      <!-- Alert red, and it is not a shade of Hub.Danger. Danger is a statement about an act ("this will do
           something you cannot undo"); this one is a statement about attention ("something here is waiting for
           you") — the taskbar badge's job, in the taskbar badge's pure saturated red. Used only by the sidebar's
           approval dot. -->
      <SolidColorBrush x:Key="Hub.AlertDot" Color="#FF0000" />

      <!-- Diff row tints for the inspector's changed-files view. The ink for a removed line is Hub.DangerText,
           which is ink and not a destructive button, so the "red is only for what runs unasked" rule is not in
           play here; these two are the row's floor. They must separate from Hub.SurfaceAlt in both variants —
           a tint that equals its surface is a tint nobody can see, which is exactly how the light-theme
           SurfaceRaised/SurfaceAlt bug looked. -->
      <SolidColorBrush x:Key="Hub.DiffAddSurface" Color="#1E322B" />
      <SolidColorBrush x:Key="Hub.DiffDeleteSurface" Color="#36232B" />

      <SolidColorBrush x:Key="Hub.GridSurface" Color="#1D2026" />
      <SolidColorBrush x:Key="Hub.GridAlternate" Color="#21252C" />
      <SolidColorBrush x:Key="Hub.GridHeader" Color="#232730" />
      <SolidColorBrush x:Key="Hub.RowHover" Color="#282D37" />
      <SolidColorBrush x:Key="Hub.RowSelected" Color="#303B4E" />

      <SolidColorBrush x:Key="Hub.ScrollTrack" Color="#00000000" />
      <SolidColorBrush x:Key="Hub.ScrollThumb" Color="#28FFFFFF" />
      <SolidColorBrush x:Key="Hub.ScrollThumbHover" Color="#48FFFFFF" />

      <SolidColorBrush x:Key="Hub.CheckBoxFill" Color="#22262E" />
      <SolidColorBrush x:Key="Hub.CheckBoxBorder" Color="#38FFFFFF" />
      <SolidColorBrush x:Key="Hub.CheckMark" Color="#FFFFFF" />

      <!-- ==================== Brand mark ====================
           The app icon's own gradient, for the sidebar title block's mark (Hub.Image.Brand). Deliberately not
           Hub.Accent: the brand is a fixed identity that must not move when a theme or an accent changes, and
           on a light background the source icon's violet end needs one step less saturation to sit on white.
           Hub.BrandCore is the pale core disc; the sparkle is cut out of it by even-odd, so this is the ink
           that shows through the cutout. -->
      <LinearGradientBrush x:Key="Hub.BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#A845D8" />
        <GradientStop Offset="0.5" Color="#6470EE" />
        <GradientStop Offset="1" Color="#3EC8F5" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="Hub.BrandCore" Color="#9FE8FF" />

      <!-- ==================== Title bar ====================
           The window's own title bar (this app draws it: ExtendClientAreaToDecorationsHint). It takes
           Hub.Background rather than a surface of its own, because the bar has no content of its own to sit
           above — it is the same plane as the page, separated by the one hairline. One subtle hairline
           rather than Hub.Border, so the bar reads as the window's edge and not as a toolbar. -->
      <SolidColorBrush x:Key="Hub.TitleBarBackground" Color="#1A1C21" />
      <SolidColorBrush x:Key="Hub.TitleBarBorder" Color="#18FFFFFF" />
      <!-- The three caption plates. Hover/pressed follow the platform convention (a plain neutral wash) and the
           close plate is the one exception it always is: nothing else may turn red, and this must. -->
      <SolidColorBrush x:Key="Hub.WindowButtonHover" Color="#18FFFFFF" />
      <SolidColorBrush x:Key="Hub.WindowButtonPressed" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseHover" Color="#C42B1C" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseForeground" Color="#FFFFFF" />

      <BoxShadows x:Key="Hub.Shadow.Card">0 6 20 0 #34000000</BoxShadows>
      <BoxShadows x:Key="Hub.Shadow.Popover">0 8 24 0 #38000000</BoxShadows>
      <BoxShadows x:Key="Hub.Shadow.Modal">0 12 32 0 #48000000</BoxShadows>
      <BoxShadows x:Key="Hub.Shadow.Toast">0 2 10 0 #44000000</BoxShadows>

    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">

      <!-- Light is not the inverse of dark but a separately chosen set of values: cards are brighter
           than the page (white), and the sidebar is slightly darker than the page, matching the
           light-theme conventions of macOS / Windows. -->
      <SolidColorBrush x:Key="Hub.Background" Color="#F5F6F9" />
      <SolidColorBrush x:Key="Hub.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#ECEEF3" />
      <SolidColorBrush x:Key="Hub.SurfaceChrome" Color="#E7E9EF" />
      <!-- A light theme has nowhere above white to lift a surface, so "raised" here means "one step above the well
           it sits in": the chips and attachment pills live on SurfaceAlt (the composer), and the value below
           separates cleanly from SurfaceAlt while keeping a hairline border. -->
      <SolidColorBrush x:Key="Hub.SurfaceRaised" Color="#F8F9FC" />
      <SolidColorBrush x:Key="Hub.SurfaceSunken" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.ProviderSurface" Color="#EEF0F5" />
      <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#E3E6EE" />
      <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#D9E4F7" />
      <SolidColorBrush x:Key="Hub.PopupSurface" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Border" Color="#21182436" />
      <SolidColorBrush x:Key="Hub.BorderSubtle" Color="#14182436" />
      <SolidColorBrush x:Key="Hub.BorderStrong" Color="#33182436" />
      <SolidColorBrush x:Key="Hub.BorderHover" Color="#4C82D4" />
      <SolidColorBrush x:Key="Hub.BorderFocus" Color="#265CB0" />

      <SolidColorBrush x:Key="Hub.TextPrimary" Color="#171A21" />
      <!-- Light counterpart of the reading rung; see the Dark dictionary's note. Light has nowhere darker than
           the primary to go, so one step toward the page's own grey is all this can be: >12:1 on
           Hub.Background, still the brightest ink in a message after its headings. -->
      <SolidColorBrush x:Key="Hub.TextBody" Color="#2B303B" />
      <SolidColorBrush x:Key="Hub.TextSecondary" Color="#5F6778" />
      <SolidColorBrush x:Key="Hub.TextTertiary" Color="#81899B" />
      <SolidColorBrush x:Key="Hub.TextDisabled" Color="#A0A7B6" />
      <SolidColorBrush x:Key="Hub.TextOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Accent" Color="#265CB0" />
      <SolidColorBrush x:Key="Hub.AccentBorder" Color="#1E4E99" />
      <SolidColorBrush x:Key="Hub.AccentSoft" Color="#3068BF" />
      <SolidColorBrush x:Key="Hub.AccentSoftBorder" Color="#2557A6" />
      <SolidColorBrush x:Key="Hub.Link" Color="#2258AB" />
      <SolidColorBrush x:Key="Hub.LinkHover" Color="#184285" />

      <!-- Light counterparts; see the Dark dictionary's note for what the pair is for. -->
      <SolidColorBrush x:Key="Hub.Selection" Color="#55265CB0" />
      <SolidColorBrush x:Key="Hub.CodeSelection" Color="#D8E6FB" />
      <SolidColorBrush x:Key="Hub.SelectionChip" Color="#A3C1F5" />

      <SolidColorBrush x:Key="Hub.Success" Color="#1C9B72" />
      <SolidColorBrush x:Key="Hub.StatusWorking" Color="#A66C00" />
      <!-- The ink weight of success, and it has to differ here: Hub.Success is a fill and does not clear AA
           as small text on Hub.SurfaceAlt. This is the same hue taken dark enough to clear AA (>5:1). -->
      <SolidColorBrush x:Key="Hub.SuccessText" Color="#126E52" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBackground" Color="#FEF3C7" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeForeground" Color="#78490A" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBorder" Color="#E6C46A" />
      <SolidColorBrush x:Key="Hub.Danger" Color="#C63A55" />
      <SolidColorBrush x:Key="Hub.WarningText" Color="#B45309" />
      <SolidColorBrush x:Key="Hub.LogWarning" Color="#825600" />
      <SolidColorBrush x:Key="Hub.DangerText" Color="#C63A55" />
      <SolidColorBrush x:Key="Hub.DangerBorder" Color="#E5A6B2" />
      <!-- The badge red on light, the same pure red as the Dark dictionary's Hub.AlertDot — one signal, one
           colour, in both variants. See that note for why it is not a shade of Hub.Danger. -->
      <SolidColorBrush x:Key="Hub.AlertDot" Color="#FF0000" />

      <!-- Light counterparts of the diff row tints; see the Dark dictionary's note. Light has nowhere above
           white to go, so both sit clearly below Hub.SurfaceAlt instead of above it. -->
      <SolidColorBrush x:Key="Hub.DiffAddSurface" Color="#E3F1E8" />
      <SolidColorBrush x:Key="Hub.DiffDeleteSurface" Color="#F6E6EA" />

      <SolidColorBrush x:Key="Hub.GridSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.GridAlternate" Color="#F9FAFC" />
      <SolidColorBrush x:Key="Hub.GridHeader" Color="#F0F2F6" />
      <SolidColorBrush x:Key="Hub.RowHover" Color="#EDF1F7" />
      <SolidColorBrush x:Key="Hub.RowSelected" Color="#D6E4FA" />

      <SolidColorBrush x:Key="Hub.ScrollTrack" Color="#00000000" />
      <SolidColorBrush x:Key="Hub.ScrollThumb" Color="#28182436" />
      <SolidColorBrush x:Key="Hub.ScrollThumbHover" Color="#47182436" />

      <SolidColorBrush x:Key="Hub.CheckBoxFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.CheckBoxBorder" Color="#33182436" />
      <SolidColorBrush x:Key="Hub.CheckMark" Color="#FFFFFF" />

      <!-- Light counterparts; see the Dark dictionary's note for what each one is for. The brand gradient is
           one stop less saturated at its violet end so the mark keeps its contrast on a white sidebar. -->
      <LinearGradientBrush x:Key="Hub.BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#9530C6" />
        <GradientStop Offset="0.5" Color="#4E5CDD" />
        <GradientStop Offset="1" Color="#1FA8D8" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="Hub.BrandCore" Color="#1B8FC4" />

      <!-- The title bar is white here rather than Hub.Background: on light, the page's plane is a near-white
           with no card under the bar, and a bar one step *above* the page is what the platform does. -->
      <SolidColorBrush x:Key="Hub.TitleBarBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.TitleBarBorder" Color="#16182436" />
      <SolidColorBrush x:Key="Hub.WindowButtonHover" Color="#12182436" />
      <SolidColorBrush x:Key="Hub.WindowButtonPressed" Color="#21182436" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseHover" Color="#C42B1C" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseForeground" Color="#FFFFFF" />

      <!-- Lighter cool-slate shadows in Light theme so floating surfaces stay crisp instead of smudging white pages. -->
      <BoxShadows x:Key="Hub.Shadow.Card">0 4 14 0 #12182436</BoxShadows>
      <BoxShadows x:Key="Hub.Shadow.Popover">0 6 18 0 #18182436</BoxShadows>
      <BoxShadows x:Key="Hub.Shadow.Modal">0 10 28 0 #20182436</BoxShadows>
      <BoxShadows x:Key="Hub.Shadow.Toast">0 2 10 0 #1A182436</BoxShadows>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
