<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe only suppresses the console window on Windows; on macOS / Linux it is a plain executable. -->
    <OutputType>WinExe</OutputType>
    <!-- Deliberately no -windows suffix: this project must build on all three platforms. Avalonia 12.1.3's
         lib/ ships both net8.0 and net10.0, so aligning with Core / Cli on net8.0 is enough — no TFM bump.
         On 2026-10-09 we did bump to net8.0-windows10.0.19041.0 for in-process WinRT toasts, and reverted it
         the same day after measuring, for two reasons:
         ① a Windows-platform TFM makes NuGet silently drop HarfBuzzSharp.NativeAssets.macOS from the osx
            dependency graph, so `dotnet publish -r osx-arm64` produces no libHarfBuzzSharp.dylib (the same
            command does on fae2bd8); Skia / Avalonia.Native natives survive, so only text shaping vanishes
            without a sound — an explicit pin is the only thing that keeps it — and "re-count the native
            assets on every upgrade" is exactly the class of silent regression we just walked into.
         ② The claim "that PowerShell script can load WinRT types", used to argue for going back to an
            out-of-process helper, was disproven by measurement on 2026-10-10: Windows PowerShell 5.1 on
            this machine (Windows 11 26300) has **lost ContentType=WindowsRuntime type resolution
            entirely** — ToastNotificationManager / XmlDocument / StorageFile all fail, even
            [Windows.Foundation.Uri, Windows.Foundation, ContentType=WindowsRuntime] fails
            (a positive control proved the script really ran; both the winmd files in
            System32\WinMetadata and System.Runtime.WindowsRuntime in the GAC are present, so nothing is
            missing). That entry in the real event log, `Windows toast helper failed ... Unable to find
            type [...]`, is precisely this, for every single notification.
            Conclusion: the out-of-process script route cannot be made to work on this machine in any form,
            and ① is still true, so neither option survives — toasts moved to an **in-process hand-written
            WinRT ABI interop** (RoGetActivationFactory + vtable, see Services/WindowsToastInterop.cs;
            zero dependencies, TFM untouched, dependency graph untouched). The IIDs and vtable slots were
            measured by the tmp/winrt-probe probe (RESULT=OK) and are pinned by the verify-shell self-check. -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Name history: AxmolHub.App.Avalonia (coexistence period with the WPF version) → AxmolHub.App
         (.Avalonia dropped in P6 after the WPF version was deleted — that was a pure rename, namespace /
         x:Class / avares untouched) → AxmolHub (2026-10-08). The reason for keeping `.App` disappeared at
         P6, yet it kept costing real damage: the assembly name simultaneously decides three interlinked
         identities — the Linux window class (Avalonia uses the entry assembly name as the WM_CLASS
         default), the avares:// resource authority, and the value of vpk's mainExe pack argument — while
         the release identity is packId `Axmol.Hub` and the desktop entry is the kebab-case `axmol-hub`;
         with four names that never match, icon lookup was always wrong. This time namespace / x:Class /
         avares were changed along with it, because the assembly name itself changed: avares:// addresses
         by assembly name, so missing one spot is not a display problem — AvaloniaXamlLoader.Load throws
         at startup. AssemblyName is not declared explicitly: the project is already named AxmolHub, so
         that is the default, and writing it a second time would only create a second place to keep in
         sync at the next rename. -->
    <AssemblyTitle>Axmol Hub</AssemblyTitle>
    <Product>Axmol Hub</Product>
    <FileDescription>Axmol Hub</FileDescription>
    <Description>Axmol Hub</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Version lives in Directory.Build.props at the repo root: all four projects share one product version. -->
    <!-- Windows DPI / transparent-window behavior depends on this manifest; the SDK ignores the property on non-Windows builds. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Matches build.yml's **packaging** matrix (four jobs: package-win-x64 / -osx-arm64 / -osx-x64 /
         -linux-x64, same source as the platform table in installer/Publish-All.ps1). Same rationale as
         AxmolHub.Cli.csproj: lock files are only stable when the RID set is complete — miss one RID and
         that (tracked) lock file loses a native-asset section on that platform. Added the previously
         missing osx-x64 on 2026-10-04; same day corrected `ci.yml` to `build.yml` in this comment (the
         former no longer exists) and spelled out the "three-platform matrix": that is the verify matrix,
         packaging is four. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <DefineConstants Condition="'$(HubIsPrereleaseBuild)' == 'true'">$(DefineConstants);HUB_PRERELEASE_BUILD</DefineConstants>
    <!-- Owns releases from P6 on: the icon travels with the project (it used to live in the WPF project,
         and that cross-project reference was exactly the kind of coupling P1 removed). -->
    <ApplicationIcon>Assets/hub-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every NuGet dependency in the repo lives here: the Avalonia group + Velopack (moved from the WPF
         project in P6 — the dependency set did not change, only its host project). Core and Cli stay
         zero-dependency and offline-buildable. -->
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- DataGrid is not in Avalonia core and must be referenced separately. This is the conclusion of
         spike #2: pick the package over the built-in TableView added in 12.1 — the WPF version has 35
         DataGrid references (column definitions + cell templates), and DataGrid's API surface is the
         closest match, which keeps the P5 migration a mechanical replacement. Note this package trails
         core by one patch version (12.1.2 vs 12.1.3); the dependency constraint is >=, so it resolves
         normally. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Avalonia.Fonts.Inter deliberately not added: Inter has no CJK glyphs and Hub's UI is Chinese-first;
         font selection belongs to P3, so pulling it in here would only bake in the wrong default. -->
    <!-- Dev-time visual-tree debugger. Written as the official template prescribes: excluded from compilation
         entirely under Release. Note the 12.x package is AvaloniaUI.DiagnosticsSupport; Avalonia.Diagnostics
         stopped at 11.3.22 and never shipped a 12.x release. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AxmolHub.Core/AxmolHub.Core.csproj" />
    <!-- The AI assistant needs the Agent layer (OpenAI-compatible client factory + OS credential store).
         Agent's own NuGet dependencies (Microsoft.Extensions.AI, .OpenAI, ProtectedData) flow through
         transitively, which is why App gains them without repeating them above. -->
    <ProjectReference Include="../AxmolHub.Agent/AxmolHub.Agent.csproj" />
    <!-- Content list aligned line-for-line with the original WPF version; icon assets were moved in P6
         (see the ApplicationIcon above). -->
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../AxmolHub.Core/Scripts/*.ps1" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../manifests/*.json" Link="manifests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../manifests/*.xml" Link="manifests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets/Cpp.xshd" />
    <!-- Each icon travels its own channel: .ico is compiled into the Windows exe by the ApplicationIcon
         above; .icns is the macOS bundle icon; hub-icon-512.png is vpk's icon argument (it becomes the
         .DirIcon and the hicolor icon inside AppDir). The 256 and 512 sizes are also read once more by
         the runtime itself: 256 serves as the window icon (X11's _NET_WM_ICON carries raw ARGB32, so an
         X property of ~6 MB from the 1254 original is unacceptable), and both sizes are planted into
         hicolor's 256x256 and 512x512 buckets respectively (the bucket name must equal the image's real
         size, or a theme picking images per bucket picks the wrong one). They ride as Content rather
         than avares:// for the same reason as manifests/*.json and Core/Scripts/*.ps1: data files read
         by code rather than XAML follow the output directory. This also keeps Linux desktop integration
         independent of Avalonia being initialized — the Linux integration self-check relies on exactly
         this to assert, on a headless server, that the icons really do get planted (see
         LinuxIntegrationSelfCheck). Still deliberately not marked Resource / None — that would duplicate
         the SDK's implicit None inclusion (NETSDK1022). -->
    <Content Include="Assets/hub-icon-256.png" Link="Assets/hub-icon-256.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/hub-icon-512.png" Link="Assets/hub-icon-512.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
