<SyntaxDefinition name="C++" extensions=".c;.h;.cc;.cpp;.cxx;.hpp"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#99A6BA" fontStyle="italic" />
  <Color name="Keyword" foreground="#C9A0FA" />
  <Color name="ControlFlow" foreground="#F78DA7" />
  <Color name="Type" foreground="#6BD6CC" />
  <Color name="MethodCall" foreground="#7DBBFF" />
  <Color name="String" foreground="#9ED58A" />
  <Color name="Number" foreground="#F0AF74" />
  <Color name="Preprocessor" foreground="#E8C97E" />
  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" begin="/\*" end="\*/" multiline="true" />
    <Span color="Preprocessor" begin="^\s*#\s*[a-zA-Z_]\w*" />
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="String" begin="'" end="'" />
    <Rule color="Number">\b(0x[0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?[uUlLfF]*)\b</Rule>
    <Keywords color="ControlFlow">
      <Word>break</Word>
      <Word>case</Word>
      <Word>catch</Word>
      <Word>continue</Word>
      <Word>default</Word>
      <Word>do</Word>
      <Word>else</Word>
      <Word>for</Word>
      <Word>if</Word>
      <Word>return</Word>
      <Word>switch</Word>
      <Word>throw</Word>
      <Word>try</Word>
      <Word>while</Word>
    </Keywords>
    <Keywords color="Number">
      <Word>false</Word>
      <Word>nullptr</Word>
      <Word>true</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>alignas</Word>
      <Word>auto</Word>
      <Word>class</Word>
      <Word>const</Word>
      <Word>constexpr</Word>
      <Word>delete</Word>
      <Word>enum</Word>
      <Word>inline</Word>
      <Word>namespace</Word>
      <Word>new</Word>
      <Word>override</Word>
      <Word>private</Word>
      <Word>protected</Word>
      <Word>public</Word>
      <Word>sizeof</Word>
      <Word>static</Word>
      <Word>struct</Word>
      <Word>template</Word>
      <Word>this</Word>
      <Word>typedef</Word>
      <Word>typename</Word>
      <Word>using</Word>
      <Word>virtual</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>bool</Word>
      <Word>char</Word>
      <Word>double</Word>
      <Word>float</Word>
      <Word>int</Word>
      <Word>long</Word>
      <Word>short</Word>
      <Word>signed</Word>
      <Word>unsigned</Word>
      <Word>void</Word>
      <Word>size_t</Word>
      <Word>string</Word>
      <Word>vector</Word>
      <Word>cout</Word>
      <Word>cin</Word>
      <Word>endl</Word>
    </Keywords>
    <Rule color="MethodCall">\b[A-Za-z_]\w*(?=\s*\()</Rule>
  </RuleSet>
</SyntaxDefinition>
