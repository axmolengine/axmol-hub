<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AxmolHub.HubDialog"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Axmol Hub">

  <!-- Avalonia has no MessageBox. We build our own instead of pulling in a third-party package: the
       repo already hand-writes all control styles, so building our own reuses HubTokens / HubControls
       directly and adds no dependency.

       It must be able to **display standalone with no host window** — in the WPF version App.xaml.cs
       used MessageBox to report "startup failed" before the main window was created, and that path
       already worked in the constructor (owner is null). -->
  <Grid RowDefinitions="Auto,*">
    <!-- Row 0 is the header this app draws for itself (Views/HubDialogChrome.cs): 32px, the shell's own bar
         colour, one close plate at the corner. The row is Auto rather than a literal 32 because the height is
         the chrome's number, not this file's. Its caption is the window's Title, which is why there is no title
         TextBlock below — a confirm box that wrote its question twice would be chrome saying it twice.

         A ContentControl rather than the control itself, because the header is built in code from a constructor
         that takes this window; the XAML cannot pass that. -->
    <ContentControl Grid.Row="0" x:Name="ChromeHost" />

    <!-- The body used to sit inside Border.card, which was a card standing in for the frame the platform no
         longer draws: the window now has its own drawn edge, so the content goes straight on the window's
         background and the hairline under the bar is the one separator it needs. -->
    <StackPanel Grid.Row="1" Spacing="14" Margin="20,14,20,18">
      <!-- A caller-supplied logo (the About box's). Collapsed rather than left empty for every other use of this
           box: a confirmation or a notice with a blank square above the question would be chrome saying nothing. -->
      <Image Name="DialogPicture" Width="64" Height="64" IsVisible="False" HorizontalAlignment="Left"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <!-- Long text (exception stack traces) goes through scrolling, so the dialog never grows off-screen. -->
      <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <TextBlock Name="DialogMessage" Classes="muted" TextWrapping="Wrap" />
      </ScrollViewer>
      <!-- Group the closing rows so the About footer stays close to its links. Optional rows collapse fully;
           ordinary confirmation dialogs still have only their buttons here. -->
      <StackPanel Spacing="8">
        <StackPanel Name="DialogLinks" Spacing="8" HorizontalAlignment="Left" IsVisible="False" />
        <StackPanel Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
        <ContentControl Name="DialogFooter" HorizontalAlignment="Center" IsVisible="False" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
