<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AxmolHub"
             x:Class="AxmolHub.ChatSidebar"
             x:DataType="local:ChatSidebar">

  <UserControl.Styles>
    <!-- Conversation rows (moved verbatim from ChatPanel styles). -->
    <Style Selector="Button.session">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.session:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.session.active">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.session-menu">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.session-row:pointerover Button.session-menu">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.session-menu:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>

    <!-- Group headers. The plate, the arrow and the hover brightening come from the shell's HubExpanderHeader
         theme (see ChatSidebar.BuildGroupHeader) — the default theme paints a checked ToggleButton with a solid
         accent block, which would turn a quiet row label into a highlight. What is set here is only how quiet and
         how small a group label is, and the colour goes on the control rather than on its text block, because a
         Foreground of the TextBlock's own would outrank the theme's hover brightening and leave the label dead.
         The group's ⋯ deliberately does NOT reuse the "session-menu" class: the list counts those buttons to prove
         every row has an actions menu, and a group wearing the class would be counted as a session. -->
    <Style Selector="ToggleButton.group-toggle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.group-header">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.group-menu">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.group-row:pointerover Button.group-menu">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.group-menu:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <!-- The ＋ on a group header, at the outer right edge of the row: it starts a session that belongs to that
         group, so it appears exactly where the place has already been named. It has its own class for the same
         reason the group's ⋯ does — one class family is read as proof that every row has an actions menu, the
         other as a group's menu titles — so a ＋ wearing either would be read as something it is not. Reveal
         follows the row: a group header is hover chrome like everything else here. -->
    <Style Selector="Button.group-new">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.group-new Path">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Grid.group-row:pointerover Button.group-new">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.group-new:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
    </Style>
    <Style Selector="Button.group-new:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Search field, collapsed until the magnifier in the assistant navigation row is clicked. -->
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" IsVisible="False"
             Margin="0,2,0,4" Padding="9,6"
             PlaceholderText="{DynamicResource SearchConversations}"
             PlaceholderForeground="{DynamicResource Hub.TextTertiary}" />

    <Grid>
      <ScrollViewer x:Name="ConversationScrollViewer"
                    VerticalScrollBarVisibility="Visible">
        <!-- Keep group actions out of the scrollbar's hit area at every list height. -->
        <StackPanel x:Name="ConversationList" Spacing="3" Margin="0,0,16,0" />
      </ScrollViewer>
      <Border x:Name="IdleScrollThumb" Width="6" Margin="0,2,2,2"
              HorizontalAlignment="Right"
              Background="{DynamicResource Hub.ScrollThumb}" CornerRadius="4"
              IsVisible="False" IsHitTestVisible="False" />
    </Grid>
  </DockPanel>
</UserControl>
