<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AxmolHub"
             x:Class="AxmolHub.ToolchainsPage"
             x:DataType="local:ToolchainsPage">

  <!--
    Toolchains page. Title row → engine version bar → component details (toolchain table).
    Platform/architecture buildability is expressed by BuildTargets; there is no longer a separate "module" concept.

    Two cards sit below the details area, in the fixed rows: the host's PowerShell and the engine setup button. They are
    neighbours because they are one causal chain — setup.ps1 is the action that needs pwsh — and keeping them in fixed
    rows ensures a prerequisite you need is never scrolled out of view.
  -->

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="{DynamicResource Toolchains}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource ToolsHint}" Classes="muted" Margin="0,8,12,0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{DynamicResource Hub.Surface}" CornerRadius="6"
            Padding="18,16" Margin="0,0,0,18">
      <DockPanel>
        <TextBlock Text="{DynamicResource EngineVersion}" Margin="0,0,16,0" />
        <ComboBox x:Name="EnginePicker" Width="320" HorizontalAlignment="Left" />
      </DockPanel>
    </Border>

    <Expander x:Name="DetailsExpander" Grid.Row="2" Header="{DynamicResource ComponentDetails}"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <DockPanel Grid.Row="0">
          <TextBlock Text="{DynamicResource Platform}" Margin="0,0,16,0" />
          <ComboBox x:Name="ToolTargetPicker" Width="280" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="ToolTargetHint" Foreground="{DynamicResource Hub.TextSecondary}"
                   TextWrapping="Wrap" Margin="0,10,0,12" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource Hub.Border}"
                BorderThickness="1" CornerRadius="7" ClipToBounds="True">
          <DataGrid x:Name="ToolsGrid" Classes="library-grid"
                    CanUserSortColumns="False" CanUserResizeColumns="True" IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Resources>
              <!-- Diagnostic rows follow the toolchain probe order; omit the unused sort-icon reserve. -->
              <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="Auto" MinWidth="220" MaxWidth="360">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Component}" TextWrapping="NoWrap" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ToolRow">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="Auto" MinWidth="100">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Status}" TextWrapping="NoWrap" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ToolRow">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                               TextWrapping="NoWrap" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*" MinWidth="280">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Details}" TextWrapping="NoWrap" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ToolRow">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Executable}" IsVisible="{Binding HasExecutable}"
                                 Foreground="{DynamicResource Hub.TextSecondary}" FontSize="12"
                                 TextWrapping="Wrap" ToolTip.Tip="{Binding Executable}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
          <Button x:Name="VerifyButton" Content="{DynamicResource Verify}" Classes="compact quiet" />
        </WrapPanel>
      </Grid>
    </Expander>

    <!-- The host shell card. One line of status plus one action button whose label changes with the state
         (install → re-check after a terminal hand-off → hidden once the probe agrees pwsh is ready), so the page
         never grows a second control for the same job. The text is written in code because it is a formatted,
         pre-localized sentence — the same convention the tools table follows. -->
    <Border x:Name="HostShellCard" Grid.Row="3" Background="{DynamicResource Hub.Surface}" CornerRadius="6" Padding="18,14" Margin="0,12,0,0">
      <DockPanel>
        <Button x:Name="InstallPwshButton" Content="{DynamicResource InstallPowerShell7}" Classes="compact quiet more"
                DockPanel.Dock="Right" Margin="18,0,0,0" />
        <TextBlock x:Name="HostShellStatus" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource Hub.Surface}" CornerRadius="6" Padding="18,14" Margin="0,12,0,6">
      <DockPanel>
        <Button x:Name="RunEngineSetupButton" Content="{DynamicResource RunEngineSetup}" Classes="compact primary more" DockPanel.Dock="Right" Margin="18,0,0,0" />
        <TextBlock Text="{DynamicResource EngineSetupHint}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
