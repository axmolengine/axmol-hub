<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AxmolHub.Core"
             xmlns:local="using:AxmolHub"
             x:Class="AxmolHub.ProjectsPage"
             x:DataType="local:ProjectsPage">

  <UserControl.Styles>
    <Style Selector="DataGridRow Button.project-row-action">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGridRow:pointerover Button.project-row-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="DataGridRow:selected Button.project-row-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="DataGridRow:focus-within Button.project-row-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Border.project-search:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,14">
        <TextBlock Text="{DynamicResource Projects}" FontSize="28" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,18,0" />
        <Border Grid.Column="1" Classes="project-search" Width="400" MaxWidth="420" Height="42" VerticalAlignment="Center"
                Background="{DynamicResource Hub.SurfaceSunken}" BorderBrush="{DynamicResource Hub.BorderStrong}"
                BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
          <Grid ColumnDefinitions="40,*,36">
            <Path Grid.Column="0" Data="{StaticResource Hub.Icon.Search}" Width="18" Height="18"
                  Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Hub.TextSecondary}"
                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="{DynamicResource Search}"
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                     PlaceholderForeground="{DynamicResource Hub.TextSecondary}"
                     VerticalContentAlignment="Center" />
            <Button x:Name="ClearSearchButton" Grid.Column="2" Classes="quiet" Padding="0"
                    Width="28" Height="28" VerticalAlignment="Center" IsVisible="False"
                    ToolTip.Tip="{DynamicResource ClearSearch}">
              <Path Data="{StaticResource Hub.Icon.Close}" Width="14" Height="14" Stretch="Uniform"
                    Stroke="{DynamicResource Hub.TextSecondary}" StrokeThickness="1.7" />
            </Button>
          </Grid>
        </Border>
        <Button Grid.Column="2" x:Name="OpenExistingButton" Content="{DynamicResource OpenExisting}"
                Classes="quiet more" Margin="0,0,8,0" />
        <Button Grid.Column="3" x:Name="NewProjectButton" Content="{DynamicResource NewProject}"
                Classes="primary" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,10">
        <ComboBox x:Name="EngineFilter" MinWidth="155" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" x:Name="PlatformFilter" MinWidth="145" Margin="0" />
        <TextBlock Grid.Column="2" x:Name="ResultCount" Classes="muted"
                   VerticalAlignment="Center" Margin="14,0,0,0" />
        <Button Grid.Column="3" x:Name="SortButton" Classes="compact quiet" Margin="0" />
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource Hub.Border}"
              BorderThickness="1" CornerRadius="7" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="ProjectsGrid" CanUserSortColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Name}" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Margin="4,2" Spacing="3">
                      <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ProjectTypeLabel}" Foreground="{DynamicResource Hub.TextSecondary}"
                                 FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource Hub.TextSecondary}"
                                 FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Project.Path}" />
                      <TextBlock x:Name="CompactDetails" Text="{Binding CompactDetails}" IsVisible="False"
                                 Foreground="{DynamicResource Hub.TextSecondary}" TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding ExactLastOpened}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="180">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource BuildTarget}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Margin="2,2" Spacing="3">
                      <TextBlock Text="{Binding Target}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ConfigurationAndStatus}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="130">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EngineVersion}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <TextBlock Text="{Binding Engine}" Margin="2,2" TextWrapping="Wrap" ToolTip.Tip="{Binding Project.Channel}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="145">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource LastOpened}" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <TextBlock Text="{Binding LastOpened}" Margin="2,2" TextWrapping="Wrap"
                               ToolTip.Tip="{Binding ExactLastOpened}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="276">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Actions}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                      <Button Content="{DynamicResource Open}" Tag="{Binding Project}" Click="OnOpenProject"
                              Classes="project-row-action quiet" Padding="7,5"
                              IsEnabled="{Binding CanOpenEditor}"
                              ToolTip.Tip="{Binding OpenEditorTooltip}"
                              AutomationProperties.Name="{Binding OpenEditorTooltip}" />
                      <Button Content="{DynamicResource Build}" Tag="{Binding Project}" Click="OnBuildProject"
                              Classes="project-row-action quiet" Padding="7,5"
                              AutomationProperties.Name="{DynamicResource Build}" />
                      <Button Content="{Binding RunCaption}" Tag="{Binding Project}" Click="OnRunProject"
                              Classes="project-row-action quiet" Padding="7,5"
                              AutomationProperties.Name="{Binding RunCaption}" />
                      <Button Content="⋯" Tag="{Binding Project}" Click="OnProjectMenu"
                              Classes="project-row-action quiet" Padding="9,5" ToolTip.Tip="{DynamicResource MoreActions}"
                              AutomationProperties.Name="{DynamicResource MoreActions}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*" IsVisible="False">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Name}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Margin="4,2" Spacing="3">
                      <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource Hub.TextSecondary}"
                                 FontSize="11" TextWrapping="Wrap" ToolTip.Tip="{Binding Project.Path}" />
                      <TextBlock Text="{Binding CompactDetails}" Foreground="{DynamicResource Hub.TextSecondary}"
                                 TextWrapping="Wrap" ToolTip.Tip="{Binding ExactLastOpened}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyProjectsPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="10" IsVisible="False">
            <TextBlock x:Name="EmptyProjects" Classes="muted" TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button Content="{DynamicResource OpenExisting}" Click="OnOpenExisting" Classes="compact quiet more" Margin="0" />
              <Button Content="{DynamicResource NewProject}" Click="OnNewProject" Classes="compact primary" Margin="0" />
            </StackPanel>
            <Button x:Name="ClearFiltersButton" Content="{DynamicResource ClearSearch}" Click="OnClearFilters"
                    Classes="compact quiet" Margin="0" IsVisible="False" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="ProjectOverlay" IsVisible="False" ClipToBounds="True" Panel.ZIndex="10">
      <Border Classes="settings-scrim" />
      <Border x:Name="OverlayCard" Classes="settings-card" Width="760" MaxHeight="680"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
        <Grid RowDefinitions="56,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="22,0,16,0">
            <TextBlock x:Name="OverlayTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="OverlayCloseButton" Classes="viewer-action" VerticalAlignment="Center"
                    Content="×" Click="OnCloseOverlay" ToolTip.Tip="{DynamicResource CloseWindow}" />
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource Hub.BorderSubtle}" BorderThickness="0,1,0,0">
            <ScrollViewer x:Name="OverlayScrollViewer" VerticalScrollBarVisibility="Auto">
              <Grid x:Name="OverlayContent" Margin="24,20">
                <StackPanel x:Name="CreatePanel" Spacing="14" IsVisible="False">
                  <TextBlock Text="{DynamicResource Template}" Classes="muted" />
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource ProjectName}" />
                      <TextBox x:Name="ProjectNameBox" Text="HelloAxmol" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Location}" />
                      <DockPanel>
                        <Button x:Name="BrowseLocationButton" Content="{DynamicResource Browse}"
                                DockPanel.Dock="Right" Margin="6,0,0,0" Classes="compact more" />
                        <TextBox x:Name="ProjectLocationBox" Margin="0" />
                      </DockPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource EngineVersion}" />
                      <ComboBox x:Name="ProjectEnginePicker" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="7">
                    <TextBlock Text="{DynamicResource Scripting}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <RadioButton x:Name="CppScripting" GroupName="ProjectScripting"
                                   Content="{DynamicResource cpp}" IsChecked="True" />
                      <RadioButton x:Name="LuaScripting" GroupName="ProjectScripting"
                                   Content="{DynamicResource lua}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ScriptingHint}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="7">
                    <CheckBox x:Name="PrebuiltCheck" Content="{DynamicResource UsePrebuilt}" />
                    <TextBlock x:Name="PrebuiltHint" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource BuildPlatformHint}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="TrashConfirmPanel" Spacing="12" IsVisible="False">
                  <TextBlock x:Name="TrashConfirmMessage" TextWrapping="Wrap" />
                  <TextBlock x:Name="TrashProjectName" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="TrashProjectPath" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="2" x:Name="OverlayActions" Orientation="Horizontal" HorizontalAlignment="Right"
                      Margin="16,12,20,16" Spacing="8">
            <Button x:Name="OverlayCancelButton" Content="{DynamicResource Cancel}" Click="OnCloseOverlay"
                    Classes="compact quiet" Margin="0" />
            <Button x:Name="OverlayPrimaryButton" Classes="compact primary" Margin="0" Click="OnOverlayPrimary" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
