<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AxmolHub.Core"
             xmlns:local="using:AxmolHub"
             x:Class="AxmolHub.ProjectsPage"
             x:DataType="local:ProjectsPage">

  <UserControl.Styles>
    <Style Selector="DataGridRow Button.project-row-action">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGridRow:pointerover Button.project-row-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="DataGridRow:selected Button.project-row-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="DataGridRow:focus-within Button.project-row-action">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="DataGridRow Button.project-row-action.building">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Border.project-search:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,14">
        <TextBlock Text="{DynamicResource Projects}" FontSize="28" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,18,0" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Classes="project-search" Width="400" MaxWidth="420" Height="{DynamicResource Hub.Control.Height}" VerticalAlignment="Center"
                Background="{DynamicResource Hub.SurfaceSunken}" BorderBrush="{DynamicResource Hub.BorderStrong}"
                BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
          <Grid ColumnDefinitions="32,*,36">
            <Path Grid.Column="0" Classes="field-glyph" Data="{StaticResource Hub.Icon.Search}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="{DynamicResource Search}"
                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" Margin="0"
                     PlaceholderForeground="{DynamicResource Hub.TextSecondary}"
                     VerticalContentAlignment="Center" />
            <Button x:Name="ClearSearchButton" Grid.Column="2" Classes="quiet" Padding="0"
                    Width="28" Height="28" MinHeight="0" VerticalAlignment="Center" IsVisible="False"
                    ToolTip.Tip="{DynamicResource ClearSearch}">
              <Path Classes="field-glyph" Data="{StaticResource Hub.Icon.Close}" />
            </Button>
          </Grid>
        </Border>
        <Button Grid.Column="2" x:Name="OpenExistingButton" Content="{DynamicResource OpenExisting}"
                Classes="quiet more" Margin="0,0,8,0" VerticalAlignment="Center" />
        <Button Grid.Column="3" x:Name="NewProjectButton" Content="{DynamicResource NewProject}"
                Classes="primary" VerticalAlignment="Center" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,10">
        <ComboBox x:Name="EngineFilter" MinWidth="155" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" x:Name="PlatformFilter" MinWidth="145" Margin="0" />
        <TextBlock Grid.Column="2" x:Name="ResultCount" Classes="muted"
                   VerticalAlignment="Center" Margin="14,0,0,0" />
        <Button Grid.Column="3" x:Name="SortButton" Classes="compact quiet" Margin="0" />
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource Hub.Border}"
              BorderThickness="1" CornerRadius="7" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="ProjectsGrid" Classes="library-grid" CanUserSortColumns="False" IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Resources>
              <!-- Sorting uses the toolbar, not the column headers. -->
              <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*" MinWidth="300">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource Name}" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Margin="4,2" Spacing="3">
                      <Grid ColumnDefinitions="Auto,*">
                        <Path IsVisible="{Binding IsFolderMissing}"
                              Data="M0,0 L8,8 M8,0 L0,8" Stretch="None" Width="8" Height="8"
                              Stroke="{DynamicResource Hub.DangerText}" StrokeThickness="1.5"
                              StrokeLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center"
                              ToolTip.Tip="{DynamicResource ProjectFolderMissing}"
                              AutomationProperties.Name="{DynamicResource ProjectFolderMissing}" />
                        <TextBlock Grid.Column="1" Text="{Binding Project.Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Project.Name}" />
                      </Grid>
                      <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource Hub.TextSecondary}"
                                 FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Project.Path}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="200" MinWidth="200">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource BuildTarget}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Margin="2,2" Spacing="3">
                      <TextBlock Text="{Binding Target}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ProjectTypeAndStatus}" Classes="muted" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="SizeToHeader">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource EngineVersion}" TextWrapping="NoWrap" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Margin="2,2" Spacing="2">
                      <TextBlock Text="{Binding Project.Version}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                      <TextBlock Text="{Binding EngineChannel}" Classes="muted" IsVisible="{Binding HasEngineChannel}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Project.Channel}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="135" MinWidth="135">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="{DynamicResource LastActivity}" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <TextBlock Text="{Binding LastActivity}" Margin="2,2" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExactLastActivity}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="220" MinWidth="220">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Actions}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="local:ProjectListItem">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                      <Button Content="{Binding BuildCaption}" Tag="{Binding Project}" Click="OnBuildProject"
                              IsEnabled="{Binding CanBuildAction}"
                              Classes="project-row-action quiet" Classes.building="{Binding IsBuilding}"
                              Padding="7,5"
                              AutomationProperties.Name="{Binding BuildCaption}" />
                      <Button Tag="{Binding Project}" Click="OnRunProject" IsEnabled="{Binding CanRun}"
                              Classes="project-row-action quiet" Padding="7,5"
                              AutomationProperties.Name="{Binding RunCaption}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding RunCaption}" HorizontalAlignment="Center" />
                          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunBusy}"
                                       Width="48" MinWidth="0" Height="2" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Content="⋯" Tag="{Binding Project}" Click="OnProjectMenu"
                              Classes="project-row-action quiet" Padding="9,5" ToolTip.Tip="{DynamicResource MoreActions}"
                              AutomationProperties.Name="{DynamicResource MoreActions}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyProjectsPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="10" IsVisible="False">
            <TextBlock x:Name="EmptyProjects" Classes="muted" TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button Content="{DynamicResource OpenExisting}" Click="OnOpenExisting" Classes="compact quiet more" Margin="0" />
              <Button Content="{DynamicResource NewProject}" Click="OnNewProject" Classes="compact primary" Margin="0" />
            </StackPanel>
            <Button x:Name="ClearFiltersButton" Content="{DynamicResource ClearSearch}" Click="OnClearFilters"
                    Classes="compact quiet" Margin="0" IsVisible="False" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
