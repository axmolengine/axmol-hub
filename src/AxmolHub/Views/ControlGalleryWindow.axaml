<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AxmolHub"
        x:Class="AxmolHub.ControlGalleryWindow"
        Title="Axmol Hub — Control gallery"
        Width="1000" Height="820"
        WindowStartupLocation="CenterScreen">

  <!--
    P3's acceptance artifact: lays out every style from HubControls.axaml + HubStyles.axaml
    for cross-platform look-and-feel comparison. It is **not shipping UI** (shipping UI is only
    migrated in P5), so its labels are plain literals rather than localized copy.

    Every element that needs asserting carries an x:Name; the theme self-check mode (command-line
    switch verify-theme) walks the visual tree to verify the styles actually take effect.
  -->

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Hub.SurfaceAlt}"
            BorderBrush="{DynamicResource Hub.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="24,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Theme variant" Margin="0,0,12,0" />
          <RadioButton x:Name="VariantDark" GroupName="Variant" Content="Dark" IsChecked="True" Padding="14,9" Margin="0,0,8,0" Click="OnVariantChanged" />
          <RadioButton x:Name="VariantLight" GroupName="Variant" Content="Light" Padding="14,9" Margin="0" Click="OnVariantChanged" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Theme-layer control gallery" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Phase 3 acceptance artifact. Every style in Theme/ rendered on one surface; not shipping UI."
                     Classes="muted" Margin="0,6,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="24" Spacing="18">

        <!-- ============ Semantic colors ============ -->
        <TextBlock Text="Semantic colors" FontSize="16" FontWeight="SemiBold" />
        <Border Classes="card">
          <WrapPanel x:Name="Swatches">
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.Background}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" /><TextBlock Text="Background" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" /><TextBlock Text="Surface" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.SurfaceAlt}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" /><TextBlock Text="SurfaceAlt" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.SurfaceRaised}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" /><TextBlock Text="Raised" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.SurfaceSunken}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" /><TextBlock Text="Sunken" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.Accent}" /><TextBlock Text="Accent" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.Success}" /><TextBlock Text="Success" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.Danger}" /><TextBlock Text="Danger" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.GridSurface}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" /><TextBlock Text="Grid" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.RowSelected}" /><TextBlock Text="RowSelected" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.ScrollThumb}" /><TextBlock Text="ScrollThumb" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Margin="0,0,18,12"><Border Width="54" Height="26" CornerRadius="4" Background="{DynamicResource Hub.BorderHover}" /><TextBlock Text="BorderHover" FontSize="11" Classes="muted" Margin="0,4,0,0" /></StackPanel>
          </WrapPanel>
        </Border>

        <!-- ============ Buttons ============ -->
        <TextBlock Text="Buttons: default / primary / quiet / more / destructive / disabled" FontSize="16" FontWeight="SemiBold" />
        <Border Classes="card">
          <WrapPanel>
            <Button x:Name="BtnDefault" Content="Default button" />
            <Button x:Name="BtnPrimary" Classes="primary" Content="Primary" />
            <Button x:Name="BtnQuiet" Classes="quiet" Content="Quiet" />
            <Button x:Name="BtnMore" Classes="more" Content="Needs a dialog" />
            <Button x:Name="BtnMorePrimary" Classes="primary more" Content="Primary + more" />
            <Button x:Name="BtnDestructive" Classes="destructive" Content="Run now" />
            <Button Content="Disabled" IsEnabled="False" />
          </WrapPanel>
        </Border>

        <!-- ============ Inputs ============ -->
        <TextBlock Text="Inputs: TextBox / password / read-only / mono / ComboBox" FontSize="16" FontWeight="SemiBold" />
        <Border Classes="card">
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Plain" />
              <TextBox x:Name="TxtNormal" Text="HelloAxmol" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,16,0">
              <TextBlock Text="Password (TextBox + PasswordChar)" Classes="muted" />
              <TextBox x:Name="TxtPassword" Classes="password" PasswordChar="●" Text="secret" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Read-only" />
              <TextBox Text="C:\Axmol\engines\2.11.5" IsReadOnly="True" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
              <TextBlock Text="Multi-line mono (activity log)" Classes="muted" />
              <TextBox x:Name="TxtMono" Classes="mono" AcceptsReturn="True" Height="78"
                       TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       Text="[17:00:01] Engine ready: 2.11.5&#x0a;[17:00:02] Toolchain check passed&#x0a;[17:00:03] Build succeeded -> build/bin/HelloAxmol/" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto,*">
            <TextBlock Text="ComboBox" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="CmbEngine" SelectedIndex="1" Width="200" HorizontalAlignment="Left">
              <ComboBoxItem Content="Axmol 2.11.5 (LTS)" />
              <ComboBoxItem Content="Axmol 2.11.5 (dev)" />
              <ComboBoxItem Content="Axmol 3.0.0" />
            </ComboBox>
            <TextBlock Grid.Column="2" Text="Disabled state" VerticalAlignment="Center" Margin="24,0,12,0" />
            <ComboBox Grid.Column="3" IsEnabled="False" Width="200" HorizontalAlignment="Left">
              <ComboBoxItem Content="Not selectable" />
            </ComboBox>
          </Grid>
        </Border>

        <!-- ============ Selection ============ -->
        <TextBlock Text="CheckBox / RadioButton" FontSize="16" FontWeight="SemiBold" />
        <Border Classes="card">
          <Grid ColumnDefinitions="*,*">
            <StackPanel>
              <CheckBox x:Name="ChkChecked" Content="Checked" IsChecked="True" />
              <CheckBox Content="Unchecked" />
              <CheckBox Content="Disabled" IsEnabled="False" IsChecked="True" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <RadioButton x:Name="RadChecked" GroupName="Gallery" Content="Selected item" IsChecked="True" />
              <RadioButton GroupName="Gallery" Content="Unselected item" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ============ Expand and scroll ============ -->
        <TextBlock Text="Expander (the arrow should rotate on expand) / ScrollBar (always 10px)" FontSize="16" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <Expander x:Name="Exp" Header="Component details" IsExpanded="False" Padding="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="The content area after expansion. The arrow rotates 90 degrees from › to ⌄, matching the glyph swap the WPF build made." TextWrapping="Wrap" />
              <CheckBox Content="Extra item" />
            </StackPanel>
          </Expander>
          <Border Grid.Column="1" Classes="card" Width="240" Padding="12">
            <ScrollViewer x:Name="Scroller" Height="150">
              <StackPanel Spacing="6">
                <TextBlock Text="Scroll sample 01" /><TextBlock Text="Scroll sample 02" /><TextBlock Text="Scroll sample 03" />
                <TextBlock Text="Scroll sample 04" /><TextBlock Text="Scroll sample 05" /><TextBlock Text="Scroll sample 06" />
                <TextBlock Text="Scroll sample 07" /><TextBlock Text="Scroll sample 08" /><TextBlock Text="Scroll sample 09" />
                <TextBlock Text="Scroll sample 10" /><TextBlock Text="Scroll sample 11" /><TextBlock Text="Scroll sample 12" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ============ Table ============ -->
        <TextBlock Text="DataGrid (Avalonia.Controls.DataGrid 12.1.2)" FontSize="16" FontWeight="SemiBold" />
        <Border BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
          <DataGrid x:Name="GalleryGrid" SelectionMode="Single" x:DataType="local:GalleryProject">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
              <DataGridTextColumn Header="Build status" Binding="{Binding Status}" Width="140" />
              <DataGridTextColumn Header="Last opened" Binding="{Binding LastOpened}" Width="170" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- ============ Icons ============ -->
        <TextBlock Text="Vector icons (replacing the four Segoe MDL2 Assets private-use glyphs)" FontSize="16" FontWeight="SemiBold" />
        <Border Classes="card">
          <StackPanel Orientation="Horizontal" Spacing="30">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path x:Name="IconProjects" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource Hub.TextPrimary}" Data="{StaticResource Hub.Icon.Projects}" />
              <TextBlock Text="Projects" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path x:Name="IconInstalls" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource Hub.TextPrimary}" Data="{StaticResource Hub.Icon.Installs}" />
              <TextBlock Text="Engine" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path x:Name="IconToolchains" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource Hub.TextPrimary}" Data="{StaticResource Hub.Icon.Toolchains}" />
              <TextBlock Text="Toolchain" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path x:Name="IconSettings" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource Hub.TextPrimary}" Data="{StaticResource Hub.Icon.Settings}" />
              <TextBlock Text="Settings" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Hub.TextSecondary}" Data="{StaticResource Hub.Icon.ChevronRight}" />
              <TextBlock Text="Small size" Classes="muted" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
