<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="440"
        x:Class="AxmolHub.ShellCheckWindow"
        Width="760" Height="440"
        Title="P5 shell verification">
  <!-- All assertion results go to stdout and the report file; the window itself only exists so that
       there is a TopLevel for content to render into. The explanatory text is kept so a human opening
       it doesn't see a blank surface. -->
  <StackPanel Margin="28" Spacing="10">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="P5 shell and localization runtime checks" />
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="This window runs no business logic. It asserts, one by one, how the shell and localization behave at **runtime**: whether strings really reach the resource dictionary, whether navigation really replaces the page content, whether the frame that is actually rendered is non-blank. Results go to stdout and the report file." />
  </StackPanel>
</Window>
