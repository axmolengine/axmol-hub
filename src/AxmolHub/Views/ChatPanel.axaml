<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AxmolHub"
             x:Class="AxmolHub.ChatPanel"
             x:DataType="local:ChatPanel">

  <UserControl.Styles>
    <!--
      Markdown document elements (text, headings, links, code blocks, tables) are styled in
      Theme/HubMarkdownStyles.axaml instead of here: the markdown theme is inserted into the viewer's
      own Styles collection, which is closer to the content than this UserControl's, so a rule written
      here silently loses. The renderer's own controls (the code editor and its copy button) belong
      there too: the same renderer feeds the inspector's plan tab, which lives outside this tree, and
      a style written here reaches only this half of it.
    -->

    <!-- User message: a right-aligned subtle pill, no border, no speaker label. -->
    <Style Selector="Border.user-pill">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>

    <Style Selector="Border.reply-preview, Border.reply-quote">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.reply-preview">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MaxWidth" Value="780" />
    </Style>
    <Style Selector="Border.reply-quote">
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="TextBlock.reply-speaker">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <!-- The in-place message editor replaces the bubble's own text, so it has to disappear into the pill:
         no frame, no background, no minimum height of its own. Its ink is the body's for the same reason —
         editing a message must not brighten the words being edited. -->
    <Style Selector="TextBox.message-edit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextBody}" />
    </Style>

    <!-- The fork provenance line: muted text that is also the way back to the source session. -->
    <Style Selector="Button.fork-notice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.fork-notice:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.Link}" />
    </Style>

    <Style Selector="Button.chat-review-file">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.chat-review-file:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>

    <!-- Assistant message: no frame at all, plain text on the background. -->
    <Style Selector="Border.assistant-msg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="StackPanel.chat-activity">
      <Setter Property="Spacing" Value="7" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- The three blinking dots are gone: ActivityGlyph draws the phase the run is actually in, and hides
         itself once prose arrives. What remains here is the label and the elapsed counter, which are
         information rather than rhythm. -->
    <Style Selector="TextBlock.chat-activity-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chat-activity-elapsed">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Per-message action row: hidden until the message row is hovered. Both row kinds are Borders now
         (BuildMessageRow returns one container type), so the reveal is two rules rather than the four it took
         when a user row was a Grid and an assistant row was a Border. The transition is the house reveal:
         short enough to read as the control noticing the pointer, and on Opacity only — a layout property
         here would re-measure the transcript every frame. -->
    <Style Selector="StackPanel.message-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:00:00.090" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.message-row:pointerover StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.message-row:focus-within StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Every action is an icon button now, so the row only carries what an icon needs: the plate itself
         and its hover colour. Size and padding live on the icon class below. -->
    <Style Selector="Button.message-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.message-action.message-action-icon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.message-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.message-timestamp">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <!-- Neutral notice rows (model changed, cancellation) are built entirely in code (BuildNoticeRow): a tail row is
         built off screen, mounted, unmounted and mounted again as the reader scrolls, and a style can be resolved
         while the row has no ChatPanel above it — leaving the line at the default 14px and the action button with its
         template ellipsis for good. The class name stays because the checks look the row up by it. -->

    <!-- A call that needs permission stays on screen until it is answered. Hover-reveal would be exactly
         wrong here: an actionable request you cannot see is a reply that appears to have stalled. The card is
         framed with Hub.Border (Hub.BorderSubtle equals the raised surface, so a frame drawn with it is
         invisible), and its buttons are not red — refusing is an ordinary answer, not a destructive act. -->
    <Style Selector="Border.approval-card">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.approval-question">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.approval-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.approval-detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.approval-actions">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.approval-action">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.approval-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <!-- The same call once answered: the record stays, the buttons go. -->
    <Style Selector="Border.approval-record">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.approval-record-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <!-- A plan in the transcript is one bordered card naming the document, not the document itself: a row that
         ran to screens pushed the conversation out of view to display something read once, in one sitting. The
         frame is Hub.Border for the reason the approval card above gives — Hub.BorderSubtle equals the raised
         surface in dark, and a frame drawn with it is invisible. It hugs its content, and caps at the approval
         card's width so an open inspector can never push it past the chat column's floor. No MinHeight: the
         theme's 34 would turn a quiet line into a plate. -->
    <Style Selector="Button.plan-card">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.plan-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <Style Selector="Path.plan-card-icon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style Selector="TextBlock.plan-card-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <!-- The title is the secondary run and trims rather than wrapping: the card is one line, and the whole
         title is in its tooltip. -->
    <Style Selector="TextBlock.plan-card-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- ── The decision host: a pending call or a pending plan, asked above the input box ──
         Both kinds of decision used to be a card in a transcript row a person had scrolled away from, while
         the composer sat there offering to send a message as if nothing were owed. The card then took the
         composer's own cell and painted over it, which turned an approval into a lost draft: text half-typed
         when the question arrived was covered, greyed out, and its caret went with the focus the card grabbed.
         It now gets its own row above the frame, the way the steer strip already does — adjacent to the box,
         not in front of it. Nothing on this page may paint over ComposerContent.
         The same two exemptions the transcript card had carry over, and for the same reasons: never
         hover-gated (an actionable request you cannot see is a reply that appears to have stalled), and the
         refuse button is not red — refusing is an ordinary answer, not a destructive act. The frame is
         Hub.Border because Hub.BorderSubtle equals the raised surface in dark and would draw nothing.

         No fade-in: a decision the person has to answer appears at once. Fading the most urgent surface in
         over 140ms is a latency on the one thing that should not wait, and it leaves any pixel check that
         photographs the card before the animation clock has run holding a blank frame. The reveal-by-opacity
         motion precedent lives on the hover-gated message actions, which are the opposite case. -->
    <Style Selector="Border.decision-host">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Hub.Radius.Card}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <!-- The same bounded 820 column as the frame below it, so a card never reads as a wider band than the box. -->
      <Setter Property="MaxWidth" Value="820" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ClipToBounds" Value="True" />
      <!-- Bounded because the row above is the transcript and it must keep its pixels. The card's own detail block
           scrolls, and it hands its middle row whatever this ceiling leaves, so the answer buttons stay inside the
           clip at every expansion. See BuildToolApprovalCard. -->
      <Setter Property="MaxHeight" Value="300" />
      <!-- The host can hold the keyboard, so a letter key reaches the panel's tunnel handler before anything has
           been clicked — but only when the box is empty, never over a live draft. It is a carrier, not a control:
           no tab stop, and the adorner is nulled the way every focusable thing in this app nulls it, or the whole
           card would gain a dashed ring. -->
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="TextBlock.approval-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The risk tier, not the permission mode, picks the glyph: what is being asked about is the call. -->
    <Style Selector="Path.approval-risk">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Path.approval-risk.system-command">
      <Setter Property="Stroke" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <!-- The quiet left slot: consequences stated, not shouted. -->
    <Style Selector="Button.approval-secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.approval-secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <!-- The one accent-filled button in the composer. Filling both this and the refuse button would erase
         the distinction the fill exists to make. -->
    <Style Selector="Button.approval-allow">
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The button carries `approval-action` too, and that class's :pointerover rule declares a Background, so
         this rule has to declare one as well: a state rule that only sets Opacity loses the fill to the other
         class and the accent button turned grey under the cursor — with white ink on it, effectively blank in
         the light theme. -->
    <Style Selector="Button.approval-allow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <!-- Continue is the only accent button in the app that can be disabled, and the theme's answer to that is 40%
         opacity: the fill turns into a grey-blue smear that reads as broken rather than as not yet. Drained
         instead of dimmed, so the state change is the fill going away, which is the verb the rest of the card
         uses, and the accent keeps its ring and its ink. The second rule exists because the theme puts the 0.4 on
         the template's Frame, where a plain Opacity setter on the button cannot reach it. -->
    <Style Selector="Button.approval-allow:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.Accent}" />
    </Style>
    <Style Selector="Button.approval-allow:disabled /template/ Border#Frame">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The neutral answer on a decision card, whichever card it is: the transcript's permission card, the stall
         question, the question card and the plan review all sit on Hub.SurfaceRaised, so one plate serves them
         and no card invents a second recipe. The fill is Hub.Surface, one step below that surface, and the edge
         is what carries the button, so the edge is what had to be measured: Hub.Border is ≈1.06:1 against
         SurfaceRaised and draws nothing, while Hub.TextTertiary — what the plan review wore before this recipe
         was shared — is ≈3.5:1, i.e. text ink used as a hairline, the brightest line in the card. Hub.BorderStrong
         is the edge the base Button theme already gives every ordinary button: ≈1.4:1 in dark, ≈1.66:1 in light.
         The metrics are the accent button's own row (28 tall, 12px, normal weight), so the accent button stays the
         only loud thing beside a quiet exit instead of being out-shouted by it. -->
    <Style Selector="Button.approval-plate">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.approval-plate:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <!-- The transcript's one line for a decision still owed: a signpost, not a second card. It keeps the
         incremental renderer's invalidation honest and gives a scrolled-back reader somewhere to press. -->
    <Style Selector="Border.approval-pending-line">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.approval-pending-line TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.approval-pending-line Path">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>

    <!-- Plan review uses direct actions. Model questions keep lettered choices above the composer;
         selection lives in the letter cap without moving the row. -->
    <Style Selector="TextBlock.plan-review-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A plan's title is two words; a question is a sentence the person has to read, so it wraps and sits at the
         top of its row instead of centring against a button that is not there. -->
    <Style Selector="TextBlock.question-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The heading of the review card is the way into the plan, so it is a button — wearing the neutral plate the
         exits wear, taken down to a pill and a size smaller: 26 tall, 12,2 padding, Hub.Radius.Pill. Smaller and
         round on purpose, because a fourth plate at the exits' size read as another answer to the review instead
         of the title you press. The chevron is the whole "this opens" hint at rest; the plate's own hover (an
         accent ring) carries it from there, and the key the removed "View plan" link used survives as its tip. -->
    <Style Selector="Button.plan-review-heading">
      <Setter Property="CornerRadius" Value="{DynamicResource Hub.Radius.Pill}" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.plan-review-chevron">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="5,0,0,0" />
    </Style>
    <!-- The ring already answers the pointer; the chevron follows it so the pill has one hover state, not two. -->
    <Style Selector="Button.plan-review-heading:pointerover Path.plan-review-chevron">
      <Setter Property="Fill" Value="{DynamicResource Hub.Accent}" />
    </Style>
    <!-- MinHeight 0 because the theme's 34 would house an 18px cap in a plate, and a plate is what this list
         stopped having. The padding is what the cap plus its hover hint needs and no more. -->
    <Style Selector="Button.question-option">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.question-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <!-- An idle cap is an outline: a key on the card, not a plate on the card. The armed cap lifts to
         Hub.SurfaceRaised and takes the accent ring, which is the one treatment that separates from the card in
         both variants. Sinking it to Hub.SurfaceSunken instead was measured and rejected: that token sits four
         levels off Hub.SurfaceAlt in dark and is pure white in light, where a light theme has nowhere to lift a
         surface, so the letter would read in one theme and vanish in the other. The ring carries the state on its
         own even over a hovered row, whose fill lands one level off the lifted cap. -->
    <Style Selector="Border.question-key">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.question-key TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.question-option.selected Border.question-key">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
    </Style>
    <Style Selector="Button.question-option.selected Border.question-key TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <!-- A question's label is the same line, but it is not alone on its row: the detail under it is what makes the
         row two lines tall, so the pair has to sit as a block rather than each centring itself against half the row. -->
    <Style Selector="TextBlock.question-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.question-detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The free answer is a line in the question, not another framed composer. -->
    <Style Selector="TextBox.question-free">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MaxHeight" Value="88" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A keyboard shortcut written as a muted cap inside a decision's secondary button, so "Esc" reads as a key
         rather than as more of the label. 11px and Tertiary is the same rung the approval card's own field label
         takes; the button's 12px primary ink stays the only thing saying what the button does. -->
    <Style Selector="TextBlock.decision-kbd">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── The steer-confirm strip: what would be interjected, shown before it is ── -->
    <Style Selector="Border.steer-confirm">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Hub.Radius.Pill}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.goal-capsule">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Hub.Radius.Pill}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.goal-capsule TextBlock.goal-capsule-status">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,6,0" />
    </Style>
    <Style Selector="Border.goal-capsule TextBlock.goal-capsule-elapsed">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="Border.goal-capsule TextBlock.goal-capsule-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.plan-task-summary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" ClipToBounds="True">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.plan-task-summary:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Viewbox.plan-task-summary-icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="TextBlock.plan-task-summary-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Viewbox.plan-task-summary-chevron">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Border.steer-confirm TextBlock.steer-confirm-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.steer-confirm TextBlock.steer-confirm-suffix">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <!-- Not accent-filled on purpose: the accent belongs to the approval's allow button, and two filled
         buttons in one composer would stop either reading as the careful one. -->
    <Style Selector="Button.steer-commit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.steer-commit:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="TextBlock.steer-commit-key">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- ── A run's activity, folded into one collapsible group ── -->
    <Style Selector="Border.activity-group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- The head borrows the sidebar's Expander header theme: the same left `>`/`v` arrow, the same hover
         brightening, and — crucially — no accent plate. The default ToggleButton template paints a checked control
         with a solid accent block, which would turn a quiet run header into a purple pill. -->
    <Style Selector="ToggleButton.activity-group-head">
      <Setter Property="Theme" Value="{StaticResource HubExpanderHeader}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.activity-group-head TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.activity-row">
      <Setter Property="Margin" Value="18,3,0,3" />
    </Style>
    <Style Selector="Grid.activity-row Path.activity-status">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.Success}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.activity-row.failed Path.activity-status">
      <Setter Property="Stroke" Value="{DynamicResource Hub.DangerText}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(0.8)" />
    </Style>
    <!-- The thinking row's mark. Every other row's status is a verdict — green for a call that came back, red for
         one that did not — and a thought is neither. Same 10×10 slot so its text column lines up with the rows
         around it, quieter ink because it reports that something happened rather than that it worked. -->
    <Style Selector="Grid.activity-row.thought Path.activity-status">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <!-- The running command's terminal prompt has no verdict, so it wears neither the success tick nor the
         failure cross — just the same quiet ink the thinking row uses. -->
    <Style Selector="Grid.activity-row.running Path.activity-status">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <!-- What a row says about itself beside its sentence: a command's state while it prints, and how long it ran
         once it is done. Small and quiet, because both are a footnote to the verb they follow. -->
    <Style Selector="TextBlock.activity-row-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.activity-row TextBlock.activity-row-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <Style Selector="Grid.activity-row.failed TextBlock.activity-row-text">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Border.file-chip">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.file-chip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- An exit code that is not zero. The chip keeps its shape and sizes so the row still reads as one line; only
         the ink changes, which is the same rule the failed row's sentence follows. -->
    <Style Selector="Border.file-chip.failed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <!-- The two inks an edit is read by: +N green, −M red. Keyed on the count itself and not on a chip above it,
         because the transcript draws these numbers as bare text on a row and on the head of a run — the earlier
         selectors were scoped to a Border.file-chip that the row no longer has, so both numbers silently fell back
         to body ink and the one thing the row exists to show was the one thing with no colour. SuccessText and
         DangerText are the ink weights; Hub.Success and Hub.Danger are fills (see HubTokens). -->
    <Style Selector="TextBlock.edit-count-added">
      <Setter Property="Foreground" Value="{DynamicResource Hub.SuccessText}" />
    </Style>
    <Style Selector="TextBlock.edit-count-removed">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <!-- A count or a command preview that reads immediately after its own sentence is a fragment of that line, not
         a plate beside it: the raised wash alone separates it from the proportional text. The frame is hidden by
         colour rather than by thickness, because a 0/1 swap would grow the chip two pixels under the pointer and
         slide the digits sideways on hover. Declared after Border.file-chip so the later rule is the one that wins. -->
    <Style Selector="Border.file-chip.inline-chip">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- One folded tool exchange, and the detail it reveals when clicked. The collapsed row names the action; the
         toggle underneath it lays the whole exchange out (arguments in, payload back) so the concrete operation is
         readable on the page instead of stranded one hover away in a tooltip. A bare transparent template keeps the
         checked state from painting the Fluent accent plate behind an indented row. -->
    <Style Selector="ToggleButton.activity-row-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="0" ClipToBounds="True">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- The left slot holds the status glyph and the expander arrow in one cell; they trade places on hover rather
         than opacity-fading (a fade would blank a pixel capture), and both are 10×10 so the swap never shifts the
         row's text sideways. -->
    <Style Selector="ToggleButton.activity-row-toggle Path.activity-row-chevron">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.activity-row-toggle:pointerover Path.activity-row-chevron">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="ToggleButton.activity-row-toggle:checked Path.activity-row-chevron">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="ToggleButton.activity-row-toggle:pointerover Path.activity-status">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.activity-row-toggle:checked Path.activity-status">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.activity-detail">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="18,2,0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.activity-detail TextBlock.activity-detail-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style Selector="Border.activity-detail TextBlock.activity-detail-label:first-child">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.activity-detail TextBlock.edit-file-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Ui}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.activity-detail TextBlock.activity-detail-body">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- The result line finally gets the style its class has asked for since it was written. Size, trim and
         wrap only: colour stays owned by the muted/danger classes in the row's class list, because this page's
         rules outrank the app-level .muted and that precedence is how the page is documented to work. -->
    <Style Selector="TextBlock.tool-result-line">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxWidth" Value="760" />
    </Style>

    <!-- Floating "scroll to latest" affordance: a square plate with a down arrow, matching the other
         square ghost buttons rather than the pill/chip shapes in this page. -->
    <Style Selector="Button.scroll-bottom">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.scroll-bottom Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.scroll-bottom:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.scroll-bottom:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.turn-changes-pill">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.turn-changes-pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>

    <!-- The composer frame. -->
    <Style Selector="Border.composer">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.composer.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <!-- A drag has to be answered before the person lets go, and the frame is the only drop target on the page,
         so the ring is what says "here". Declared after `.focused` so a drag wins over the caret: the ring is the
         question being asked right now. Only the brush changes — a thicker border would move the text. -->
    <Style Selector="Border.composer.drag-over">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The permission chip: neutral until the mode is the one that never asks, and then the tier's own
         warning colour without adding a second label anywhere else. -->
    <Style Selector="Button.permission-chip Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.permission-chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.permission-chip.danger Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.WarningText}" />
    </Style>
    <Style Selector="Button.permission-chip.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.WarningText}" />
    </Style>
    <!-- The caret every composer chip carries, so they read as one affordance: "this opens a menu".
         Declared after the permission chip's own Path rules on purpose — the caret keeps its muted colour
         even when the tier it sits beside uses warning orange. -->
    <Style Selector="Path.chip-caret">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The workspace picker sits under the composer instead of in its row: the directory is the sandbox the
         session is born into, not a setting to fiddle with between requests, and it goes away once the chat
         has started. Quiet text with a hover plate — a second pill down here would compete with the ones
         inside the frame. Declared after Path.chip-caret so its own hover colour reaches the caret too. -->
    <Style Selector="Button.workspace-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.workspace-chip Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="Button.workspace-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.workspace-chip:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="ComboBox.composer-choice">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>
    <Style Selector="Button.composer-plus">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-ring-button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-ring-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <!-- The compact readouts share the composer column, but never steal width from the context button. -->
    <Style Selector="TextBlock.composer-metric">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.model-settings-popover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Width" Value="340" />
    </Style>
    <Style Selector="TextBlock.model-settings-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.model-level-caption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="Button.model-menu-button">
      <Setter Property="MinHeight" Value="{DynamicResource Hub.Control.Height}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Border.context-popover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Width" Value="400" />
    </Style>
    <Style Selector="TextBlock.context-popover-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.context-popover-detail">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.context-popover-status">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <!-- One row of the context breakdown: the heading on the left, its cost on the right. The number is a figure
         a person compares down the column, so it is the row that gets the primary ink. -->
    <Style Selector="TextBlock.context-category-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.context-category-value">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <!-- The popover's first figure, held below the title's own percentage rather than above it: two figures of
         equal weight in one card read as two headlines, and this one only has to say it is a different kind of
         number from the rows under it. Emphasis is the weight and the success ink — a cache hit is money the
         endpoint did not re-bill — not the size. Hub.SuccessText rather than Hub.Accent because blue is this
         theme's link ink, and rather than Hub.Success because that one is a fill: the light value fails contrast
         as 14px text on this card. -->
    <Style Selector="TextBlock.context-cache-hit-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.context-cache-hit-value">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.SuccessText}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.context-compress">
      <Setter Property="MinHeight" Value="{DynamicResource Hub.Control.Height}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.context-compress:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.model-picker:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.composer-plus:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.mode-indicator">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="2,0,6,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mode-indicator:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="TextBlock.mode-indicator-close">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.mode-indicator:pointerover Path.mode-indicator-icon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.mode-indicator:pointerover TextBlock.mode-indicator-close">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="WrapPanel.context-attachments">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.context-attachment">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3,4,3" />
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style Selector="TextBlock.context-attachment-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-attachment-remove">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- A message's own pictures, beside its text rather than under it: the frame is part of what the person
         said, not an attachment list. Clipped and rounded so a 5K capture stays a thumbnail inside the column. -->
    <Style Selector="WrapPanel.turn-pictures">
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Border.turn-picture">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A picture that opens is a picture you clicked, so the clickable thing is a button. The reset is what
         keeps the thumbnail pixel-for-pixel what it was, and what gives the opening a keyboard path — and a
         check can raise a click, which it cannot do to a bare pointer press. The full-size viewer it opens is
         window-level (MainWindow#PictureViewerHost), so its styles live there, not here. -->
    <Style Selector="Button.picture-face">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- A turn's own words, whether or not they are Markdown. The rendered-Markdown layer is 12 (declared in
         HubMarkdownStyles, which is the winning style set for that subtree), and only the last 40 turns go
         through it — so anything but 12 here would make the same message change size as it scrolled away. The ink
         follows the same argument: Hub.TextBody, or a message would also brighten at that boundary.
         The selector names the class rather than the control on purpose. A type selector matches that exact type,
         so `TextBlock.turn-text` stopped reaching the user's own row the moment it became a SelectableTextBlock,
         and the row fell back to the control default 14 in the primary ink — which the typography checks caught.
         Writing the class instead means the size, ink and leading are stated once for a row that can be either
         kind of block; the directive names the type the setters resolve against, since a class-only selector has
         no type of its own to resolve them on. SelectionBrush stays in its own rule below: it is the one property
         only the selectable half has. -->
    <Style Selector=".turn-text" x:SetterTargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextBody}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <!-- Selecting the person's own words paints the same band the rendered answers do, so the row does not change
         colour depending on which side of the transcript it sits on. -->
    <Style Selector="SelectableTextBlock.turn-text">
      <Setter Property="SelectionBrush" Value="{DynamicResource Hub.Selection}" />
    </Style>
    <!-- What the model thought before it answered. Deliberately not Markdown: a chain of thought is a draft, not
         a document the model was asking to have formatted, and rendering it as one would spend a viewer and a
         code editor per turn on text that arrives with no structure to honour. It reads at the body's own pitch
         so the two do not fight over line height when they sit one above the other, and one rung quieter so the
         answer stays the thing being looked at. -->
    <Style Selector="TextBlock.turn-reasoning">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <!-- How long a run took, said once at the end of the answer it belongs to. Quieter than the body, and
         deliberately not hover-revealed: the reader watched this number climb, so the moment it stops working is
         the worst possible moment to hide it behind a pointer. -->
    <Style Selector="TextBlock.run-elapsed">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The empty state's suggestion chips: the greeting's promise stated as things the assistant can actually
         do. Quiet by default — secondary text on a hairline pill — so the centred column still reads as a greeting
         first and a starting point second, and wraps inside a bounded row instead of widening the column. -->
    <Style Selector="WrapPanel.suggestion-row">
      <Setter Property="MaxWidth" Value="620" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Button.suggestion-chip">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.suggestion-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="local|ContextUsageRing">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="TrackBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="ProgressBrush" Value="{DynamicResource Hub.Accent}" />
    </Style>
    <Style Selector="Button.send">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <!-- Message area: messages flow directly on the background, centered 820px column. -->
    <Grid Grid.Row="0">
      <ScrollViewer x:Name="MessageScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
        <!-- The reading column's gutter. Hub's ScrollBar is opaque, always visible once the transcript overflows,
             and drawn *over* the content it belongs to (Theme/HubControls.axaml), so a column measured against
             the scroller's whole width keeps its last bar-width — the user pill's tail, an activity row's trailing
             chip, the end of a code line — behind the track. The inset is on both sides rather than the right
             alone so the column between them keeps the centre the composer shares with it, and
             UpdateMessageColumnWidth makes the same subtraction from HubMetrics.ScrollBarThickness. -->
        <Border x:Name="MessageColumn" MaxWidth="820" HorizontalAlignment="Center"
                Margin="10,16,10,16" ClipToBounds="True">
          <ItemsControl x:Name="MessageFlow" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Buffered viewports in 12.1.3 can stay stale for mixed-height rows. Realize the current viewport. -->
                <local:TranscriptRowsPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Border>
      </ScrollViewer>
      <!-- Keep the scrollbar independent of the virtual panel's changing physical extent. -->
      <ScrollBar x:Name="TranscriptScrollBar" Orientation="Vertical" HorizontalAlignment="Right"
                 VerticalAlignment="Stretch" IsVisible="False" Focusable="False" />

      <!-- Empty state: centered greeting without prefilled prompts. -->
      <StackPanel x:Name="EmptyState" IsVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="12" Margin="24">
        <TextBlock x:Name="GreetingLabel"
                   FontSize="19" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="GreetingSubtitle" Classes="muted"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <!-- Suggested starting points, built from the text table so they follow the language. They are filled
             into the composer rather than sent: a chip is an offer, and the person still decides. -->
        <WrapPanel x:Name="SuggestionPanel" Classes="suggestion-row" />
      </StackPanel>
      <!-- The way back down to the newest line used to float here, at the bottom of this cell. It moved into the
           band above the composer, beside the change tally, because two centered plates stacked one over the other
           read as one broken object — and because a floating plate over the transcript is chrome the charter has no
           room for. See the band below. -->
    </Grid>

    <!-- Composer: centered to the same column. The rows above the frame are ordered by what they owe the person.
         Row 0 is the band — the session's change tally and the way back down to the newest line. It is the only
         thing up here that is not owed an answer, and that is exactly why it sits farthest from the box: a question
         keeps the row nearest the input, so nothing a person has to reply to is ever pushed behind a readout.
         Row 1 is the decision host — a pending call or a pending plan; row 2 the steer-confirm strip, where a
         second tap stands between Enter and a steer, because a steer is the routing table's strongest signal and
         worth reading once before it is said. Row 4 is the active goal capsule, nearest the box after a steer draft.
         Nothing is cancelled either way: the sentence waits for the step in flight. Row 6 aligns the workspace
         picker, per-request metrics and context button below the frame.
         Both strips are siblings of the frame, never children of it: the input box stays live and its draft stays
         visible while a question is waiting, which is the whole reason they moved. -->
    <!-- The composer, and every question that may stand above it, sit in the reading column with the same gutter
         as the transcript: the column's right edge is where the transcript's is meant to be, so the inset goes on
         the whole stack rather than on one card in it (see the transcript scroller's note for why the gutter
         exists at all). -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="10,0,10,0">
      <!-- Keep the changes pill centered over the composer; the scroll control moves to the side when both show.
           Reserve the scrollable transcript's band height so the button does not resize the reading area. -->
      <Grid x:Name="ComposerBand" Grid.Row="0" ColumnDefinitions="*,Auto,*" MaxWidth="820"
            HorizontalAlignment="Stretch" Margin="0,0,0,6">
          <Button x:Name="TurnChangesPill" Grid.Column="1" Classes="turn-changes-pill" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <TextBlock x:Name="TurnChangesLabel" Foreground="{DynamicResource Hub.TextSecondary}" FontSize="12" />
              <TextBlock x:Name="TurnChangesAdded" Foreground="{DynamicResource Hub.Success}" FontSize="12" />
              <TextBlock x:Name="TurnChangesRemoved" Foreground="{DynamicResource Hub.Danger}" FontSize="12" />
            </StackPanel>
          </Button>
          <Button x:Name="ScrollToBottomButton" Grid.Column="1" Classes="scroll-bottom" IsVisible="False">
            <Grid Width="26" Height="26">
              <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Hub.Icon.ArrowDown}" />
              <local:ScrollAttentionMarquee x:Name="ScrollAttentionMarquee" IsActive="False" IsHitTestVisible="False" />
            </Grid>
          </Button>
      </Grid>
      <Border x:Name="PlanTasksHost" Grid.Row="1" IsVisible="False" MaxWidth="820"
              ClipToBounds="True" HorizontalAlignment="Stretch" Margin="0,0,0,6"
              Background="{DynamicResource Hub.SurfaceAlt}"
              BorderBrush="{DynamicResource Hub.Border}" BorderThickness="1" CornerRadius="8" />
      <Border x:Name="DecisionHost" Classes="decision-host" Grid.Row="2"
              IsVisible="False" />
      <Border x:Name="SteerConfirmHost" Classes="steer-confirm" Grid.Row="3"
              IsVisible="False" MaxWidth="820" />
      <Border x:Name="GoalCapsuleHost" Classes="goal-capsule" Grid.Row="4"
              IsVisible="False" MaxWidth="820" />
      <!-- The frame wears Hub.Surface — the same raised card the settings card wears — not Hub.SurfaceAlt.
           SurfaceAlt is the sidebar's chrome plane; the input box must float *above* the reading page and
           read as a card, not sit on the same gray strip as the spine. In dark that lifts it off #1E1E1E;
           in light it becomes a white card on the #F4F5F7 page. The shell check pins the separation. -->
      <Border x:Name="ComposerFrame" Classes="composer" Grid.Row="5"
              Background="{DynamicResource Hub.Surface}" CornerRadius="14"
              HorizontalAlignment="Stretch" MaxWidth="820" ClipToBounds="True"
              Margin="0,6,0,0" Padding="14,12,12,10">
        <Grid x:Name="ComposerContent" RowDefinitions="Auto,Auto,Auto,Auto">
          <Border x:Name="ReplyPreview" Grid.Row="0" Classes="reply-preview" IsVisible="False" />
          <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True" MinHeight="48" MaxHeight="160"
                   TextWrapping="Wrap" PlaceholderText="{DynamicResource InputPlaceholder}"
                   PlaceholderForeground="{DynamicResource Hub.TextTertiary}"
                   VerticalContentAlignment="Top"
                   Background="Transparent" BorderThickness="0" CornerRadius="0"
                   Padding="2,0" Margin="0" />
          <WrapPanel x:Name="ContextAttachmentPanel" Grid.Row="2" Classes="context-attachments"
                     IsVisible="False" />
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <WrapPanel x:Name="ComposerChoices" Grid.Column="0" VerticalAlignment="Center">
              <Button x:Name="AddContextButton" Classes="composer-plus"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="{DynamicResource ChatAddContext}">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Data="{StaticResource Hub.Icon.Plus}"
                      Fill="Transparent" Stroke="{DynamicResource Hub.TextSecondary}"
                      StrokeThickness="1.8" StrokeLineCap="Round" />
              </Button>
              <!-- What the assistant may do without asking, named where the asking would happen. The label is
                   the *effective* mode, so a session that merely follows a permissive default reads as
                   permissive rather than looking safe. -->
              <Button x:Name="PermissionChip" Classes="chip permission-chip" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path x:Name="PermissionChipIcon" Width="13" Height="13" Stretch="Uniform"
                        Fill="Transparent" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                        VerticalAlignment="Center" />
                  <TextBlock x:Name="PermissionChipLabel" VerticalAlignment="Center" />
                  <Path Classes="chip-caret" Data="{StaticResource Hub.Icon.Caret}" />
                </StackPanel>
              </Button>
              <!-- The plan marker: it names the mode of the session on screen, and only plan wears one — an
                   unticked pair in the ＋ menu already reads as the default goal, and ask is a chat with no tools
                   rather than something to advertise. The × picks the default back. -->
              <Button x:Name="ModeIndicatorButton" Classes="mode-indicator"
                      VerticalAlignment="Center" IsVisible="False">
                <Grid ColumnDefinitions="14,*">
                  <Path x:Name="ModeIndicatorIcon" Classes="mode-indicator-icon" Width="13" Height="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Stretch="Uniform" Fill="Transparent"
                        Stroke="{DynamicResource Hub.TextSecondary}" StrokeThickness="1.7"
                        StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Classes="mode-indicator-close" Text="×" FontFamily="{DynamicResource Hub.Font.Ui}"
                             FontSize="15" TextAlignment="Center" Width="14" Height="18"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Hub.DangerText}" />
                  <TextBlock x:Name="ModeIndicatorLabel" Classes="mode-indicator-label"
                             Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center" Margin="8,0,0,0">
              <Button x:Name="ModelPicker" Classes="chip model-picker"
                      HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock x:Name="SelectedModelLabel" MaxWidth="130"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock x:Name="SelectedReasoningLabel" MaxWidth="76"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource Hub.TextTertiary}" />
                  <Path Classes="chip-caret" Data="{StaticResource Hub.Icon.Caret}" />
                </StackPanel>
              </Button>
              <Button x:Name="SendButton" Classes="send" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- The workspace stays at left; the spring keeps the three statuses together at right.
           Speed and context keep their width; the spend label trims first on narrow windows. -->
      <Grid x:Name="ComposerStatusRow" Grid.Row="6" ColumnDefinitions="Auto,*,Auto,*,Auto" MaxWidth="820" HorizontalAlignment="Stretch"
            Margin="0,3,0,4" MinHeight="30" ColumnSpacing="8">
        <Button x:Name="WorkspaceChip" Grid.Column="0" Classes="workspace-chip" MaxWidth="160">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Hub.Icon.Folder}"
                  Fill="Transparent" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                  VerticalAlignment="Center" />
            <TextBlock x:Name="WorkspaceChipLabel" VerticalAlignment="Center" MaxWidth="120"
                       TextTrimming="CharacterEllipsis" />
            <Path x:Name="WorkspaceChipCaret" Classes="chip-caret" Data="{StaticResource Hub.Icon.Caret}" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="RequestSpeedLabel" Classes="composer-metric" Grid.Column="2"
                   MaxWidth="120" IsVisible="False" />
        <TextBlock x:Name="SessionBurnLabel" Classes="composer-metric" Grid.Column="3"
                   MaxWidth="210" HorizontalAlignment="Right" TextAlignment="Right" IsVisible="False" />
        <Button x:Name="ContextButton" Grid.Column="4" Classes="context-ring-button"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <local:ContextUsageRing x:Name="ContextRing" Width="20" Height="20" />
            <TextBlock x:Name="ContextPercentLabel" Classes="composer-metric" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
    <Popup x:Name="ModelSettingsPopup" IsLightDismissEnabled="True">
      <Border Classes="model-settings-popover">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource ChatAutoReasoning}" Classes="model-settings-title" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="AutoReasoningSwitch" Grid.Column="1" />
          </Grid>
          <TextBlock x:Name="ReasoningLevelLabel" Classes="context-popover-detail" />
          <Slider x:Name="ReasoningLevelSlider" Minimum="0" Maximum="2" TickFrequency="1"
                  IsSnapToTickEnabled="True" />
          <Grid x:Name="ReasoningEffortLabels" />
          <Button x:Name="OpenModelMenuButton" Classes="model-menu-button" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ModelSettingsSelectedModel" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="›" Margin="10,0,0,0" />
            </Grid>
          </Button>
          <!-- What the answers here are billed against, in the one place a person already opens to tune the
               model. It replaces a permanent pill beside the send button that read as a usage meter while never
               showing a number: this note claims only what is true, and only while a plan model is selected. -->
          <TextBlock x:Name="PlanUsageNote" Classes="context-popover-detail" TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="ContextPopup" IsLightDismissEnabled="True">
    <Border Classes="context-popover">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ContextPopoverTitle" Classes="context-popover-title"
                     Text="{DynamicResource ChatContextWindow}" />
          <TextBlock x:Name="ContextPopoverPercent" Grid.Column="1"
                     Classes="context-popover-title" />
        </Grid>
        <TextBlock Classes="context-popover-detail"
                   Text="{DynamicResource ChatContextPopoverHint}" />
        <Grid x:Name="ContextProgressTrack" Height="6" ClipToBounds="True">
          <Border Background="{DynamicResource Hub.SurfaceRaised}" CornerRadius="3" />
          <Border x:Name="ContextProgressFill" HorizontalAlignment="Left"
                  Background="{DynamicResource Hub.Success}" CornerRadius="3" />
        </Grid>
        <!-- The cache hit rate, above every row of the breakdown and bolder than any of them: it is the one figure
             here that is a ratio over the session's own bill rather than a slice of the window, and the reason
             somebody opens this panel when a long conversation starts costing more per turn. Its own block and
             never a row inside the list below — those rows add up to the occupancy reading and this one divides
             two other numbers — and hidden outright when no endpoint reported a cache split, because silence is
             not a hit rate of zero. -->
        <Grid x:Name="CacheHitBlock" ColumnDefinitions="*,Auto" IsVisible="False">
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="context-cache-hit-label" Text="{DynamicResource ChatContextCacheHitTitle}" />
            <TextBlock x:Name="CacheHitDetail" Classes="context-popover-status" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="CacheHitValue" Grid.Column="1" Classes="context-cache-hit-value"
                     VerticalAlignment="Center" />
        </Grid>
        <!-- The breakdown, rebuilt from the same reading as the ring on every refresh: rows a person can act on
             (schemas by mode, attachments by un-adding a folder, messages by compressing) and the two lines that
             say where the denominator came from and how many turns never went out. -->
        <StackPanel x:Name="ContextCategoryList" Spacing="3" />
        <!-- What the answer cost, in the endpoint's own reported tokens. Its own block rather than rows inside the
             breakdown above, because those rows are an estimate that adds up to the occupancy figure, and a measured
             number dropped in among them would read as one more category. -->
        <TextBlock x:Name="ContextBurnNote" Classes="context-popover-status" TextWrapping="Wrap"
                   IsVisible="False" />
        <TextBlock x:Name="ContextPopoverSource" Classes="context-popover-status" TextWrapping="Wrap" />
        <TextBlock x:Name="ContextPopoverNote" Classes="context-popover-status" TextWrapping="Wrap"
                   IsVisible="False" />
        <Button x:Name="CompressContextButton" Classes="context-compress"
                HorizontalContentAlignment="Center"
                Content="{DynamicResource ChatCompressContext}" />
      </StackPanel>
    </Border>
    </Popup>
  </Grid>
</UserControl>
