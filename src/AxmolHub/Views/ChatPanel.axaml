<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AxmolHub"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="AxmolHub.ChatPanel"
             x:DataType="local:ChatPanel">

  <UserControl.Styles>
    <!--
      Markdown document elements (text, headings, links, code blocks, tables) are styled in
      Theme/HubMarkdownStyles.axaml instead of here: the markdown theme is inserted into the viewer's
      own Styles collection, which is closer to the content than this UserControl's, so a rule written
      here silently loses. Only the controls our renderer creates are safe to style below.
    -->
    <Style Selector="ae|TextEditor.markdown-code-editor">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.markdown-code-copy">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Path Width="15"
                  Height="15"
                  Stretch="Uniform"
                  Data="{StaticResource Hub.Icon.Copy}"
                  Fill="Transparent"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.8" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.markdown-code-copy:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>

    <!-- User message: a right-aligned subtle pill, no border, no speaker label. -->
    <Style Selector="Border.user-pill">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- The in-place message editor replaces the bubble's own text, so it has to disappear into the pill:
         no frame, no background, no minimum height of its own. -->
    <Style Selector="TextBox.message-edit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>

    <!-- The fork provenance line: muted text that is also the way back to the source session. -->
    <Style Selector="Button.fork-notice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.fork-notice:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.Link}" />
    </Style>

    <!-- Assistant message: no frame at all, plain text on the background. -->
    <Style Selector="Border.assistant-msg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="StackPanel.chat-activity">
      <Setter Property="Spacing" Value="7" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- The three blinking dots are gone: ActivityGlyph draws the phase the run is actually in, and hides
         itself once prose arrives. What remains here is the label and the elapsed counter, which are
         information rather than rhythm. -->
    <Style Selector="TextBlock.chat-activity-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chat-activity-elapsed">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Per-message action row: hidden until the message row is hovered. Both row kinds are Borders now
         (BuildMessageRow returns one container type), so the reveal is two rules rather than the four it took
         when a user row was a Grid and an assistant row was a Border. The transition is the house reveal:
         short enough to read as the control noticing the pointer, and on Opacity only — a layout property
         here would re-measure the transcript every frame. -->
    <Style Selector="StackPanel.message-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:00:00.090" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.message-row:pointerover StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.message-row:focus-within StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Every action is an icon button now, so the row only carries what an icon needs: the plate itself
         and its hover colour. Size and padding live on the icon class below. -->
    <Style Selector="Button.message-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.message-action.message-action-icon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.message-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.message-timestamp">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <!-- Neutral notice rows (model changed, cancellation): small icon + one muted line. -->
    <Style Selector="Grid.notice">
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="Grid.notice Path.notice-icon">
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="Grid.notice TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.notice.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Grid.notice.danger Path.notice-icon">
      <Setter Property="Fill" Value="{DynamicResource Hub.DangerText}" />
    </Style>

    <!-- A call that needs permission stays on screen until it is answered. Hover-reveal would be exactly
         wrong here: an actionable request you cannot see is a reply that appears to have stalled. The card is
         framed with Hub.Border (Hub.BorderSubtle equals the raised surface, so a frame drawn with it is
         invisible), and its buttons are not red — refusing is an ordinary answer, not a destructive act. -->
    <Style Selector="Border.approval-card">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.approval-question">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.approval-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.approval-detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.approval-actions">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.approval-action">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.approval-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <!-- The same call once answered: the record stays, the buttons go. -->
    <Style Selector="Border.approval-record">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.approval-record-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <!-- The one exit a write has. It stays visible instead of waiting for a hover, because an undo nobody can
         find is a mistake that cannot be fixed — and because the row it rides on is otherwise muted text with
         nothing clickable on it at all. Accent colour, no plate: the action is small on purpose. -->
    <Style Selector="Button.undo-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.undo-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>

    <!-- ── The decision host: a pending call or a pending plan, asked in the composer ──
         Both kinds of decision used to be a card in a transcript row a person had scrolled away from, while
         the composer sat there offering to send a message as if nothing were owed. The host replaces the
         composer's own content instead of floating over it, so the input area cannot visibly jump and the
         send button cannot keep offering itself.
         The same two exemptions the transcript card had carry over, and for the same reasons: never
         hover-gated (an actionable request you cannot see is a reply that appears to have stalled), and the
         refuse button is not red — refusing is an ordinary answer, not a destructive act. The frame is
         Hub.Border because Hub.BorderSubtle equals the raised surface in dark and would draw nothing.

         No fade-in: a decision the person has to answer appears at once. Fading the most urgent surface in
         over 140ms is a latency on the one thing that should not wait, and it leaves any pixel check that
         photographs the card before the animation clock has run holding a blank frame. The reveal-by-opacity
         motion precedent lives on the hover-gated message actions, which are the opposite case. -->
    <Style Selector="Border.decision-host">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Hub.Radius.Frame}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="MaxHeight" Value="300" />
    </Style>
    <Style Selector="TextBlock.approval-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The risk tier, not the permission mode, picks the glyph: what is being asked about is the call. -->
    <Style Selector="Path.approval-risk">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Path.approval-risk.system-command">
      <Setter Property="Stroke" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <!-- The quiet left slot: consequences stated, not shouted. -->
    <Style Selector="Button.approval-secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.approval-secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <!-- The one accent-filled button in the composer. Filling both this and the refuse button would erase
         the distinction the fill exists to make. -->
    <Style Selector="Button.approval-allow">
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.approval-allow:pointerover">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.approval-deny">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.approval-deny:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <!-- The transcript's one line for a decision still owed: a signpost, not a second card. It keeps the
         incremental renderer's invalidation honest and gives a scrolled-back reader somewhere to press. -->
    <Style Selector="Border.approval-pending-line">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.approval-pending-line TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.approval-pending-line Path">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>

    <!-- ── Plan review: lettered options over the composer ── -->
    <Style Selector="TextBlock.plan-review-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.plan-review-open">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.plan-review-open:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.plan-review-option">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.plan-review-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.plan-review-option.selected">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
    </Style>
    <Style Selector="Border.plan-review-key">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.plan-review-key TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.plan-review-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="TextBox.plan-feedback">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MaxHeight" Value="88" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="28,4,0,0" />
    </Style>
    <Style Selector="Button.plan-review-cancel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.plan-review-cancel:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="TextBlock.plan-review-kbd">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- ── The steer-confirm strip: what would be interjected, shown before it is ── -->
    <Style Selector="Border.steer-confirm">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Hub.Radius.Pill}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.steer-confirm TextBlock.steer-confirm-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.steer-confirm TextBlock.steer-confirm-suffix">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <!-- Not accent-filled on purpose: the accent belongs to the approval's allow button, and two filled
         buttons in one composer would stop either reading as the careful one. -->
    <Style Selector="Button.steer-commit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.steer-commit:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="TextBlock.steer-commit-key">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- ── A run's activity, folded into one collapsible group ── -->
    <Style Selector="Border.activity-group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.activity-group-head">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ToggleButton.activity-group-head:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="ToggleButton.activity-group-head Path.activity-group-chevron">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="ToggleButton.activity-group-head:checked Path.activity-group-chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ToggleButton.activity-group-head TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Grid.activity-row">
      <Setter Property="Margin" Value="18,3,0,3" />
    </Style>
    <Style Selector="Grid.activity-row Path.activity-status">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.Success}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.activity-row.failed Path.activity-status">
      <Setter Property="Stroke" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Grid.activity-row TextBlock.activity-row-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <Style Selector="Grid.activity-row.failed TextBlock.activity-row-text">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Border.file-chip">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.file-chip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.file-chip TextBlock.file-chip-add">
      <Setter Property="Foreground" Value="{DynamicResource Hub.Success}" />
      <Setter Property="Margin" Value="5,0,0,0" />
    </Style>
    <Style Selector="Border.file-chip TextBlock.file-chip-del">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <!-- The result line finally gets the style its class has asked for since it was written. Size, trim and
         wrap only: colour stays owned by the muted/danger classes in the row's class list, because this page's
         rules outrank the app-level .muted and that precedence is how the page is documented to work. -->
    <Style Selector="TextBlock.tool-result-line">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxWidth" Value="760" />
    </Style>

    <!-- Floating "scroll to latest" affordance: a square plate with a down arrow, matching the other
         square ghost buttons rather than the pill/chip shapes in this page. -->
    <Style Selector="Button.scroll-bottom">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.scroll-bottom Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.scroll-bottom:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.scroll-bottom:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>

    <!-- The composer frame. -->
    <Style Selector="Border.composer">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.composer.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <!-- A drag has to be answered before the person lets go, and the frame is the only drop target on the page,
         so the ring is what says "here". Declared after `.focused` so a drag wins over the caret: the ring is the
         question being asked right now. Only the brush changes — a thicker border would move the text. -->
    <Style Selector="Border.composer.drag-over">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The permission chip: neutral until the mode is the one that never asks, and then the tier's own
         warning colour without adding a second label anywhere else. -->
    <Style Selector="Button.permission-chip Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.permission-chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.permission-chip.danger Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Button.permission-chip.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <!-- The caret every composer chip carries, so they read as one affordance: "this opens a menu".
         Declared after the permission chip's own Path rules on purpose — the caret keeps its muted colour
         even when the tier it sits beside is the warning-red one. -->
    <Style Selector="Path.chip-caret">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The workspace picker sits under the composer instead of in its row: the directory is the sandbox the
         session is born into, not a setting to fiddle with between requests, and it goes away once the chat
         has started. Quiet text with a hover plate — a second pill down here would compete with the ones
         inside the frame. Declared after Path.chip-caret so its own hover colour reaches the caret too. -->
    <Style Selector="Button.workspace-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.workspace-chip Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="Button.workspace-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.workspace-chip:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="ComboBox.composer-choice">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>
    <Style Selector="Button.composer-plus">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-ring-button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-ring-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Border.context-popover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Width" Value="400" />
    </Style>
    <Style Selector="TextBlock.context-popover-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.context-popover-detail">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.context-popover-status">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <!-- One row of the context breakdown: the heading on the left, its cost on the right. The number is a figure
         a person compares down the column, so it is the row that gets the primary ink. -->
    <Style Selector="TextBlock.context-category-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.context-category-value">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.context-compress">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.context-compress:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.model-picker:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="Button.composer-plus:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.mode-indicator">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mode-indicator:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="TextBlock.mode-indicator-close">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.mode-indicator:pointerover Path.mode-indicator-icon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.mode-indicator:pointerover TextBlock.mode-indicator-close">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="WrapPanel.context-attachments">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.context-attachment">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3,4,3" />
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style Selector="TextBlock.context-attachment-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-attachment-remove">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- A message's own pictures, beside its text rather than under it: the frame is part of what the person
         said, not an attachment list. Clipped and rounded so a 5K capture stays a thumbnail inside the column. -->
    <Style Selector="WrapPanel.turn-pictures">
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Border.turn-picture">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A picture that opens is a picture you clicked, so the clickable thing is a button. The reset is what
         keeps the thumbnail pixel-for-pixel what it was, and what gives the opening a keyboard path — and a
         check can raise a click, which it cannot do to a bare pointer press. The full-size viewer it opens is
         window-level (MainWindow#PictureViewerHost), so its styles live there, not here. -->
    <Style Selector="Button.picture-face">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- A turn's own words, whether or not they are Markdown. The rendered-Markdown layer is 13 (declared in
         HubMarkdownStyles, which is the winning style set for that subtree), and only the last 40 turns go
         through it — so a plain 14 here would make the same message change size as it scrolled away. -->
    <Style Selector="TextBlock.turn-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The empty state's suggestion chips: the greeting's promise stated as things the assistant can actually
         do. Quiet by default — secondary text on a hairline pill — so the centred column still reads as a greeting
         first and a starting point second, and wraps inside a bounded row instead of widening the column. -->
    <Style Selector="WrapPanel.suggestion-row">
      <Setter Property="MaxWidth" Value="620" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Button.suggestion-chip">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.suggestion-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="local|ContextUsageRing">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="TrackBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="ProgressBrush" Value="{DynamicResource Hub.Accent}" />
    </Style>
    <Style Selector="Button.send">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <!-- Message area: messages flow directly on the background, centered 820px column. -->
    <Grid Grid.Row="0">
      <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Fork provenance: one quiet line above the transcript, doubling as the jump back to the source. -->
          <Button x:Name="ForkNotice" Classes="fork-notice" IsVisible="False"
                  MaxWidth="820" HorizontalAlignment="Center" Margin="0,12,0,0" />
          <StackPanel x:Name="MessageFlow"
                      MaxWidth="820" HorizontalAlignment="Center"
                      Margin="0,16,0,16" Spacing="10" />
          <!-- What the app last had to say about a run, kept out of the flow: a row inside MessageFlow is not
               counted as a turn, so every rebuild of the transcript either erased it or left it sitting between
               two messages that arrived after it. -->
          <StackPanel x:Name="NoticeHost" Margin="0,0,0,12" />
        </StackPanel>
      </ScrollViewer>

      <!-- Empty state: centered greeting without prefilled prompts. -->
      <StackPanel x:Name="EmptyState" IsVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="12" Margin="24">
        <TextBlock x:Name="GreetingLabel"
                   FontSize="19" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="GreetingSubtitle" Classes="muted"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <!-- Suggested starting points, built from the text table so they follow the language. They are filled
             into the composer rather than sent: a chip is an offer, and the person still decides. -->
        <WrapPanel x:Name="SuggestionPanel" Classes="suggestion-row" />
      </StackPanel>

      <Button x:Name="ScrollToBottomButton" Classes="scroll-bottom"
              VerticalAlignment="Bottom" Margin="0,0,0,14" IsVisible="False">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Hub.Icon.ArrowDown}" />
      </Button>
    </Grid>

    <!-- Composer: centered to the same column. Row 0 is the steer-confirm strip — a second tap stands between
         Enter and a steer, because a steer cancels the segment being generated. Row 2 is the workspace
         picker's slot — outside the frame on purpose, and collapsed to nothing once the chat has started.
         Inside the frame, ComposerContent and DecisionHost share one cell: the host is declared second and
         paints over the content, so covering the composer never moves it. -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto">
      <Border x:Name="SteerConfirmHost" Classes="steer-confirm" Grid.Row="0"
              IsVisible="False" MaxWidth="820" />
      <Border x:Name="ComposerFrame" Classes="composer" Grid.Row="1"
              Background="{DynamicResource Hub.SurfaceAlt}" CornerRadius="14"
              HorizontalAlignment="Stretch" MaxWidth="820" ClipToBounds="True"
              Margin="0,6,0,0" Padding="14,12,12,10">
        <Grid>
          <Grid x:Name="ComposerContent" RowDefinitions="Auto,Auto,Auto">
          <TextBox x:Name="InputBox" Grid.Row="0" AcceptsReturn="True" MinHeight="48" MaxHeight="160"
                   TextWrapping="Wrap" PlaceholderText="{DynamicResource InputPlaceholder}"
                   PlaceholderForeground="{DynamicResource Hub.TextTertiary}"
                   VerticalContentAlignment="Top"
                   Background="Transparent" BorderThickness="0" CornerRadius="0"
                   Padding="2,0" Margin="0" />
          <WrapPanel x:Name="ContextAttachmentPanel" Grid.Row="1" Classes="context-attachments"
                     IsVisible="False" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <WrapPanel x:Name="ComposerChoices" Grid.Column="0" VerticalAlignment="Center">
              <Button x:Name="AddContextButton" Classes="composer-plus"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="{DynamicResource ChatAddContext}">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Data="{StaticResource Hub.Icon.Plus}"
                      Fill="Transparent" Stroke="{DynamicResource Hub.TextSecondary}"
                      StrokeThickness="1.8" StrokeLineCap="Round" />
              </Button>
              <!-- What the assistant may do without asking, named where the asking would happen. The label is
                   the *effective* mode, so a session that merely follows a permissive default reads as
                   permissive rather than looking safe. -->
              <Button x:Name="PermissionChip" Classes="chip permission-chip" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path x:Name="PermissionChipIcon" Width="13" Height="13" Stretch="Uniform"
                        Fill="Transparent" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                        VerticalAlignment="Center" />
                  <TextBlock x:Name="PermissionChipLabel" VerticalAlignment="Center" />
                  <Path Classes="chip-caret" Data="{StaticResource Hub.Icon.Caret}" />
                </StackPanel>
              </Button>
              <Button x:Name="ModeIndicatorButton" Classes="mode-indicator"
                      VerticalAlignment="Center" IsVisible="False">
                <Grid ColumnDefinitions="14,*">
                  <Path x:Name="ModeIndicatorIcon" Classes="mode-indicator-icon" Width="13" Height="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Stretch="Uniform" Fill="Transparent"
                        Stroke="{DynamicResource Hub.TextSecondary}" StrokeThickness="1.7"
                        StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Classes="mode-indicator-close" Text="×" FontFamily="{DynamicResource Hub.Font.Ui}"
                             FontSize="15" TextAlignment="Center" Width="14" Height="18"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Hub.DangerText}" />
                  <TextBlock x:Name="ModeIndicatorLabel" Classes="mode-indicator-label"
                             Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center" Margin="8,0,0,0">
              <Button x:Name="ContextButton" Classes="context-ring-button" VerticalAlignment="Center">
                <local:ContextUsageRing x:Name="ContextRing" Width="20" Height="20" />
              </Button>
              <Button x:Name="ModelPicker" Classes="chip model-picker"
                      HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock x:Name="SelectedModelLabel" MaxWidth="130"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock x:Name="SelectedReasoningLabel" MaxWidth="76"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource Hub.TextTertiary}" />
                  <Path Classes="chip-caret" Data="{StaticResource Hub.Icon.Caret}" />
                </StackPanel>
              </Button>
              <Button x:Name="SendButton" Classes="send" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          </Grid>
          <!-- The decision host. Declared after ComposerContent so it paints over it, and opaque so the
               covered input does not ghost through. Its Child is built in code because both kinds of
               decision are rebuilt from the transcript on every refresh, like everything else on this page. -->
          <Border x:Name="DecisionHost" Classes="decision-host" IsVisible="False" />
        </Grid>
      </Border>

      <!-- The sandbox the file and command tools are confined to, named by the folder itself. It sits outside
           the frame because it is not a per-request setting: the directory is what the session is born into,
           and the row collapses to nothing once the first message has been sent (see RefreshComposerChoices). -->
      <StackPanel Grid.Row="2" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,2,0,4">
        <Button x:Name="WorkspaceChip" Classes="workspace-chip">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Hub.Icon.Folder}"
                  Fill="Transparent" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                  VerticalAlignment="Center" />
            <TextBlock x:Name="WorkspaceChipLabel" VerticalAlignment="Center" />
            <Path Classes="chip-caret" Data="{StaticResource Hub.Icon.Caret}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Popup x:Name="ContextPopup" IsLightDismissEnabled="True">
    <Border Classes="context-popover">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ContextPopoverTitle" Classes="context-popover-title"
                     Text="{DynamicResource ChatContextWindow}" />
          <TextBlock x:Name="ContextPopoverPercent" Grid.Column="1"
                     Classes="context-popover-title" />
        </Grid>
        <TextBlock Classes="context-popover-detail"
                   Text="{DynamicResource ChatContextPopoverHint}" />
        <Grid x:Name="ContextProgressTrack" Height="6" ClipToBounds="True">
          <Border Background="{DynamicResource Hub.SurfaceRaised}" CornerRadius="3" />
          <Border x:Name="ContextProgressFill" HorizontalAlignment="Left"
                  Background="{DynamicResource Hub.Success}" CornerRadius="3" />
        </Grid>
        <!-- The breakdown, rebuilt from the same reading as the ring on every refresh: rows a person can act on
             (schemas by mode, attachments by un-adding a folder, messages by compressing) and the two lines that
             say where the denominator came from and how many turns never went out. -->
        <StackPanel x:Name="ContextCategoryList" Spacing="3" />
        <TextBlock x:Name="ContextPopoverSource" Classes="context-popover-status" TextWrapping="Wrap" />
        <TextBlock x:Name="ContextPopoverNote" Classes="context-popover-status" TextWrapping="Wrap"
                   IsVisible="False" />
        <Button x:Name="CompressContextButton" Classes="context-compress"
                HorizontalContentAlignment="Center"
                Content="{DynamicResource ChatCompressContext}" />
      </StackPanel>
    </Border>
    </Popup>
  </Grid>
</UserControl>
