<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AxmolHub.FoundationCheckWindow"
        Width="560" Height="320"
        Title="Axmol Hub — P4 foundation checks">

  <!-- Same role as the control gallery: a development artifact, not part of shipping UI. It does two
       things — runs the foundation assertions, and gets actually screenshotted once (the "screenshot is
       non-blank" criterion must be verified against a real image, otherwise the criterion itself has no evidence). -->
  <StackPanel Margin="28" Spacing="10">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="P4 foundation checks" />
    <TextBlock Classes="muted"
               Text="HubDialog replacing 8 MessageBox calls, the async StorageProvider wrapper, and --smoke with its non-blank criterion. P5 reuses all three while migrating window by window, so they are verified on their own first." />
    <Border Classes="card" Name="ProbeCard">
      <StackPanel Spacing="6">
        <TextBlock Text="HubDialog · Pickers · SmokeCapture" />
        <TextBlock Classes="muted" Text="Assertion results are written to the report path given to --verify-foundation, and the exit code is the failure count." />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
