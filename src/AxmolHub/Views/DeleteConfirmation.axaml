<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AxmolHub.DeleteConfirmation">
  <Border Classes="settings-card" HorizontalAlignment="Center" VerticalAlignment="Center"
          MaxWidth="560" Margin="24" Padding="0" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="24,12,16,12">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Grid.Column="1" Content="×" Classes="viewer-action"
                ToolTip.Tip="{DynamicResource CloseWindow}" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,20" Spacing="12">
          <TextBlock x:Name="Message" TextWrapping="Wrap" />
          <TextBlock x:Name="ObjectName" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ObjectPath" Classes="muted" TextWrapping="Wrap" />
          <CheckBox x:Name="UseRecycleBin" Content="{DynamicResource UseRecycleBinIfPossible}" IsChecked="True" />
          <TextBlock x:Name="PolicyMessage" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="24,0,24,20">
        <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Classes="compact quiet" Margin="0" />
        <Button x:Name="ConfirmButton" Classes="compact primary danger" Margin="0" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
