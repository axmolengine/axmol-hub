<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- This project has no PackageReference at all, so packages.lock.json would contain only empty
         framework/RID nodes that pin nothing; its content flips depending on whether the last restore
         passed -r, and this project is also transitively polluted by the App's RID publish
         (see the repo-root Directory.Build.props). So lock-file tracking is opted out.
         **When this project gains its first PackageReference, delete the line below.** -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
