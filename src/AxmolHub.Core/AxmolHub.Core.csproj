<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Core is not shipped as a NuGet package. Keep its restore identity stable across product releases. -->
    <PackageVersion>1.0.0</PackageVersion>
    <!-- This project has no PackageReference at all, so packages.lock.json would contain only empty
         framework/RID nodes that pin nothing; its content flips depending on whether the last restore
         passed -r, and this project is also transitively polluted by the App's RID publish
         (see the repo-root Directory.Build.props). So lock-file tracking is opted out.
         **When this project gains its first PackageReference, delete the line below.** -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Skills/axmol-v3-migration/SKILL.md" LogicalName="axmol-v3-migration" />
    <EmbeddedResource Include="Skills/axmol-sprite-shader/SKILL.md" LogicalName="axmol-sprite-shader" />
    <EmbeddedResource Include="Skills/axmol-lua-input/SKILL.md" LogicalName="axmol-lua-input" />
    <EmbeddedResource Include="Skills/axmol-build-cmake/SKILL.md" LogicalName="axmol-build-cmake" />
  </ItemGroup>
</Project>
