<SyntaxDefinition name="C++" extensions=".c;.h;.cc;.cpp;.cxx;.hpp"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F8799" />
  <Color name="Keyword" foreground="#F7768E" fontWeight="bold" />
  <Color name="Type" foreground="#7DCFFF" />
  <Color name="String" foreground="#7DCFFF" />
  <Color name="Number" foreground="#BB9AF7" />
  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" begin="/\*" end="\*/" />
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="String" begin="'" end="'" />
    <Rule color="Number">\b\d+(\.\d+)?\b</Rule>
    <Keywords color="Keyword">
      <Word>alignas</Word>
      <Word>auto</Word>
      <Word>bool</Word>
      <Word>break</Word>
      <Word>case</Word>
      <Word>catch</Word>
      <Word>char</Word>
      <Word>class</Word>
      <Word>const</Word>
      <Word>constexpr</Word>
      <Word>continue</Word>
      <Word>default</Word>
      <Word>delete</Word>
      <Word>do</Word>
      <Word>double</Word>
      <Word>else</Word>
      <Word>enum</Word>
      <Word>false</Word>
      <Word>float</Word>
      <Word>for</Word>
      <Word>if</Word>
      <Word>inline</Word>
      <Word>int</Word>
      <Word>long</Word>
      <Word>namespace</Word>
      <Word>new</Word>
      <Word>nullptr</Word>
      <Word>private</Word>
      <Word>protected</Word>
      <Word>public</Word>
      <Word>return</Word>
      <Word>short</Word>
      <Word>signed</Word>
      <Word>sizeof</Word>
      <Word>static</Word>
      <Word>struct</Word>
      <Word>switch</Word>
      <Word>template</Word>
      <Word>this</Word>
      <Word>throw</Word>
      <Word>true</Word>
      <Word>try</Word>
      <Word>typedef</Word>
      <Word>typename</Word>
      <Word>unsigned</Word>
      <Word>using</Word>
      <Word>virtual</Word>
      <Word>void</Word>
      <Word>while</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>size_t</Word>
      <Word>string</Word>
      <Word>vector</Word>
      <Word>cout</Word>
      <Word>cin</Word>
      <Word>endl</Word>
    </Keywords>
  </RuleSet>
</SyntaxDefinition>
