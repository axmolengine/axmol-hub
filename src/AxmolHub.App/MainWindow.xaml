<Window x:Class="AxmolHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Axmol Hub" Icon="Assets/hub-icon.ico" Width="1280" Height="880" MinWidth="1080" MinHeight="740" Background="#1E1E1E" Foreground="#E4E4E4" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#242424" BorderBrush="#353535" BorderThickness="0,0,1,0" Padding="20,30,20,22">
      <DockPanel><StackPanel DockPanel.Dock="Bottom"><Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="6,18,0,0"><StackPanel><TextBlock Text="AXMOL 2.11 LTS" Foreground="#B8B8B8" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Windows x64" Foreground="#888888" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></StackPanel><StackPanel><StackPanel Orientation="Horizontal" Margin="4,0,0,12"><Image Source="Assets/hub-icon.png" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Axmol Hub" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="BrandVersion" Foreground="#B8B8B8" FontSize="11" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Text="{DynamicResource Subtitle}" Style="{StaticResource Muted}" Margin="5,0,0,34"/><RadioButton x:Name="NavProjects" GroupName="Navigation" Click="ShowProjects" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="{DynamicResource Projects}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton x:Name="NavInstalls" GroupName="Navigation" Click="ShowInstalls" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="{DynamicResource Installs}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton x:Name="NavToolchains" GroupName="Navigation" Click="ShowToolchains" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="{DynamicResource Toolchains}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton x:Name="NavSettings" GroupName="Navigation" Click="ShowSettings" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="{DynamicResource Settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton></StackPanel></DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,30,30,22">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="Pages">
        <Grid x:Name="ProjectsPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{DynamicResource OpenExisting}" Click="OpenProject" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource NewProject}" Click="ToggleNewProject" Style="{StaticResource Primary}" Margin="0"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Projects}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ProjectsHint}" Style="{StaticResource Muted}" Margin="0,8,12,0"/></StackPanel></DockPanel>
          <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14"><StackPanel><TextBlock x:Name="ProjectCount" Text="0" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ProjectsCount}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14"><StackPanel><TextBlock x:Name="EngineCount" Text="0" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource EnginesCount}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18,14"><StackPanel><TextBlock Text="{DynamicResource LastBuildPlatform}" Style="{StaticResource Muted}"/><ComboBox x:Name="BuildTargetPicker" Visibility="Collapsed"/><TextBlock Text="{Binding SelectedItem.Name, ElementName=BuildTargetPicker}" FontSize="16" Margin="0,8,0,0"/><TextBlock x:Name="BuildHostHint" Foreground="#A8A8A8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border x:Name="NewProjectPanel" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel><DockPanel Margin="0,0,0,16"><TextBlock Text="{DynamicResource Template}" Style="{StaticResource Muted}" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="{DynamicResource NewProject}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="{DynamicResource ProjectName}" /><TextBox x:Name="ProjectName" Text="HelloAxmol"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{DynamicResource Location}" /><DockPanel Margin="0,6,0,0" Height="40"><Button Content="{DynamicResource Browse}" Click="BrowseLocation" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,8"/><TextBox x:Name="ProjectLocation" Margin="0"/></DockPanel></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource EngineVersion}" /><ComboBox x:Name="ProjectEngine"/></StackPanel>
              </Grid>
              <StackPanel Margin="0,14,0,0"><TextBlock Text="{DynamicResource Scripting}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <StackPanel.Resources><Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}"><Setter Property="Padding" Value="16,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Frame" Background="#202020" BorderBrush="#4B4B4B" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="8" BorderBrush="#A8A8A8" BorderThickness="1" Margin="0,0,10,0"><Border x:Name="Dot" Background="#399BDC" CornerRadius="5" Margin="3" Visibility="Hidden"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#399BDC"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#303030"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></StackPanel.Resources>
                <RadioButton x:Name="CppScripting" GroupName="ProjectScripting" IsChecked="True" Content="{DynamicResource cpp}" Margin="0,0,8,0"/>
                <RadioButton x:Name="LuaScripting" GroupName="ProjectScripting" Content="{DynamicResource lua}" Margin="0"/>
              </StackPanel><TextBlock Text="{DynamicResource ScriptingHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
              <DockPanel Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource Cancel}" Click="ToggleNewProject" Style="{StaticResource Quiet}" Margin="16,0,8,0"/><Button Content="{DynamicResource Create}" Click="CreateProject" Style="{StaticResource Primary}" Margin="0"/></StackPanel><TextBlock Text="{DynamicResource BuildPlatformHint}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></DockPanel>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="7" ClipToBounds="True"><Grid>
            <DataGrid x:Name="ProjectsGrid" SelectionChanged="SelectedProjectChanged"><DataGrid.Columns>
              <DataGridTemplateColumn Header="{DynamicResource Name}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="#A0A0A0" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Path}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{DynamicResource Version}" Binding="{Binding Version}" Width="85"/>
              <DataGridTextColumn Header="{DynamicResource Scripting}" Binding="{Binding ProjectType, Converter={StaticResource LocalizedValue}}" Width="110"/>
              <DataGridTemplateColumn Header="{DynamicResource BuildStatus}" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#303030" CornerRadius="4" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding BuildStatus, Converter={StaticResource LocalizedValue}}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B7B7B7"/><Style.Triggers><DataTrigger Binding="{Binding BuildStatus}" Value="Succeeded"><Setter Property="Foreground" Value="#70D7AF"/></DataTrigger><DataTrigger Binding="{Binding BuildStatus}" Value="Failed"><Setter Property="Foreground" Value="#F294A7"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{DynamicResource LastOpened}" Binding="{Binding LastOpened, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
            </DataGrid.Columns></DataGrid>
            <TextBlock Text="{DynamicResource EmptyProjects}" x:Name="EmptyProjects" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid></Border>
          <StackPanel Grid.Row="4"><Border x:Name="AndroidDevicePanel" Visibility="Collapsed" Background="#292929" CornerRadius="6" Padding="14,12" Margin="0,14,0,0"><StackPanel><DockPanel><Button Content="{DynamicResource RefreshDevices}" Click="RefreshAndroidDevices" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource AndroidDevice}" Margin="0,0,14,0"/><ComboBox x:Name="AndroidDevicePicker" Width="310" HorizontalAlignment="Left" Margin="0" DisplayMemberPath="Label" SelectedValuePath="Device"/><TextBlock x:Name="AndroidDeviceStatus" Foreground="#AAAAAA" Margin="14,0,0,0"/></DockPanel><TextBlock Text="{DynamicResource AndroidDeviceHint}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border><WrapPanel Margin="0,18,0,6"><Button Content="{DynamicResource Build}" Click="Build" Style="{StaticResource Primary}"/><Button Content="{DynamicResource Run}" Click="Run" /><Button Content="{DynamicResource Configure}" Click="Configure" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource AndroidReleaseSettings}" Click="AndroidReleaseSettingsClick" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource OpenFolder}" Click="OpenProjectFolder" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource OpenOutputs}" Click="OpenBuildOutputs" Style="{StaticResource Quiet}"/><Button Content="Visual Studio" Click="OpenVisualStudio" Style="{StaticResource Quiet}"/><Button Content="VS Code" Click="OpenCode" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource RemoveFromList}" Click="RemoveProject" Style="{StaticResource Quiet}"/></WrapPanel></StackPanel>
        </Grid>
        <Grid x:Name="InstallsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{DynamicResource ImportEngine}" Click="ImportEngine" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource InstallOfficial}" Click="InstallEngine" Style="{StaticResource Primary}" Margin="0"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Installs}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource EnginesHint}" Style="{StaticResource Muted}" Margin="0,8,12,0"/></StackPanel></DockPanel>
          <Border Grid.Row="1" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="7"><Grid><DataGrid x:Name="EnginesGrid"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Version}" Binding="{Binding Version}" Width="100"/><DataGridTextColumn Header="{DynamicResource Channel}" Binding="{Binding Channel}" Width="140"/><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="{DynamicResource EmptyEngines}" x:Name="EmptyEngines" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
          <WrapPanel Grid.Row="2" Margin="0,18,0,6"><Button Content="{DynamicResource AddModules}" Click="EngineModulesClick" Style="{StaticResource Primary}"/><Button Content="{DynamicResource SetDefault}" Click="SetDefault" /><Button Content="{DynamicResource OpenFolder}" Click="OpenEngineFolder" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource VerifyEngine}" Click="VerifyEngine" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource Repair}" Click="RepairEngine" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource Uninstall}" Click="UninstallEngine" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource RemoveFromList}" Click="RemoveEngine" Style="{StaticResource Quiet}"/></WrapPanel>
        </Grid>
        <Grid x:Name="ToolchainsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"></StackPanel><StackPanel><TextBlock Text="{DynamicResource ToolsTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ToolsHint}" Style="{StaticResource Muted}" Margin="0,8,12,0"/></StackPanel></DockPanel>
          <Border Grid.Row="1" Background="#292929" CornerRadius="6" Padding="18,16" Margin="0,0,0,18"><StackPanel><DockPanel><Button Content="{DynamicResource AddModules}" Click="ManageModules" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="18,0,0,0"/><TextBlock Text="{DynamicResource EngineVersion}" Margin="0,0,16,0"/><ComboBox x:Name="ModuleEnginePicker" Width="320" HorizontalAlignment="Left" SelectionChanged="ModuleEngineChanged" Margin="0"/></DockPanel><TextBlock Text="{DynamicResource ModulesHint}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="ModuleOverview"/><Expander Header="{DynamicResource ComponentDetails}" Margin="0,16,0,0"><StackPanel><DockPanel><TextBlock Text="{DynamicResource Platform}" Margin="0,0,16,0"/><ComboBox x:Name="ToolTargetPicker" Width="280" HorizontalAlignment="Left" SelectionChanged="ChangeToolTarget" Margin="0"/></DockPanel><TextBlock x:Name="ToolTargetHint" Foreground="#C0C0C0" TextWrapping="Wrap" Margin="0,10,0,12"/><DataGrid x:Name="ToolsGrid" Height="300" RowHeight="64"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Component}" Binding="{Binding Name, Converter={StaticResource LocalizedValue}}" Width="200"/><DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status, Converter={StaticResource LocalizedValue}}" Width="110"/><DataGridTextColumn Header="{DynamicResource Details}" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,0"><Button x:Name="InstallSdkButton" Content="{DynamicResource InstallSdk}" Click="InstallSdk"/><Button x:Name="InstallMsvcButton" Content="{DynamicResource InstallMsvc}" Click="GetBuildTools"/><Button Content="{DynamicResource Verify}" Click="VerifyTools" Style="{StaticResource Quiet}"/></WrapPanel></StackPanel></Expander></StackPanel></ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"></StackPanel><StackPanel><TextBlock Text="{DynamicResource Settings}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource SettingsHint}" Style="{StaticResource Muted}" Margin="0,8,12,0"/></StackPanel></DockPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Language}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource LanguageHint}" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><ComboBox x:Name="LanguagePicker" Grid.Column="1" Margin="0" SelectionChanged="ChangeLanguage"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Storage}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/><StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource DataDirectory}" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,0" Height="40"><Button Content="{DynamicResource Browse}" Click="ChooseDataDirectory" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="DataLocation" IsReadOnly="True" Margin="0" /></DockPanel><TextBlock Text="{DynamicResource DataHint}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource DefaultProjectDirectory}" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,0" Height="40"><Button Content="{DynamicResource Browse}" Click="ChooseProjectDirectory" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="DefaultProjectLocation" IsReadOnly="True" Margin="0" /></DockPanel><TextBlock Text="{DynamicResource ProjectDirectoryHint}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><DockPanel><Button Content="{DynamicResource OpenFolder}" Click="OpenDataFolder" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{DynamicResource DefaultEngine}" Style="{StaticResource Muted}"/><TextBlock x:Name="DefaultEngine" Margin="0,6,0,0"/></StackPanel></DockPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Editors}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource EditorHint}" Style="{StaticResource Muted}" Margin="0,7,0,16"/><DockPanel Margin="0,0,0,14"><Button Content="{DynamicResource SelectEditor}" Click="SelectVisualStudio" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Visual Studio" FontWeight="SemiBold"/><TextBlock x:Name="VisualStudioLocation" Foreground="#A8A8A8" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel><DockPanel><Button Content="{DynamicResource SelectEditor}" Click="SelectCode" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="VS Code" FontWeight="SemiBold"/><TextBlock x:Name="CodeLocation" Foreground="#A8A8A8" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,16,0,12"><Button Content="{DynamicResource Cancel}" Click="Cancel" x:Name="CancelButton" DockPanel.Dock="Right" IsEnabled="False" Padding="12,5" Margin="8,0,0,0"/><Ellipse Width="6" Height="6" Fill="#70D7AF" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="{DynamicResource Ready}" Foreground="#ADADAD" TextTrimming="CharacterEllipsis"/></DockPanel>
      <Border Grid.Row="2" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Background="#242424" Padding="12,8">
        <Expander x:Name="LogPanel" Foreground="#BDBDBD" Header="{DynamicResource LogTitle}" IsExpanded="False"><Grid Height="190" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8"><Button Content="{DynamicResource CopyError}" Click="CopyError" Style="{StaticResource Quiet}" Padding="10,5"/><Button Content="{DynamicResource OpenLogs}" Click="OpenLogs" Style="{StaticResource Quiet}" Padding="10,5" Margin="0"/></StackPanel><TextBox Grid.Row="1" x:Name="ActivityLog" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0"/></Grid></Expander>
      </Border>
    </Grid>
  </Grid>
</Window>




