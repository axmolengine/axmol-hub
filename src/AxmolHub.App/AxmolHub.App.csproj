<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.6</Version>
    <ApplicationIcon>Assets/hub-icon.ico</ApplicationIcon>
    <!-- Velopack 需要自定义 Main 来拦截 veloapp 生命周期钩子，因此不能再让 XAML 编译器生成入口点。 -->
    <StartupObject>AxmolHub.App.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- 仓库唯一的 NuGet 依赖：Core 与 Cli 仍然零依赖、可离线构建。 -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    
    <Resource Include="Assets/hub-icon.ico" />
    <Resource Include="Assets/hub-icon.png" />
    <Content Include="Invoke-Axmol.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Verify-MicrosoftSignature.ps1" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../AxmolHub.Core/AxmolHub.Core.csproj" />
    <Content Include="../../manifests/*.json" Link="manifests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../manifests/*.xml" Link="manifests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
