<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AxmolHub.App"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="AxmolHub.App.ChatPanel"
             x:DataType="local:ChatPanel">

  <UserControl.Styles>
    <!-- Markdown rendering metrics. -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Hub.Link}" />
      <Setter Property="HoverForeground" Value="{DynamicResource Hub.LinkHover}" />
      <Setter Property="IsUnderline" Value="True" />
    </Style>
    <Style Selector="Border.CodeBlock">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,10" />
    </Style>
    <Style Selector="ScrollViewer.CodeBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="TextBlock.CodeBlock">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ae|TextEditor.markdown-code-editor">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.markdown-code-copy">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Path Width="15"
                  Height="15"
                  Stretch="Uniform"
                  Data="{StaticResource Hub.Icon.Copy}"
                  Fill="Transparent"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.8" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.markdown-code-copy:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Border.CodeBlock:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>

    <!-- User message: a right-aligned subtle pill, no border, no speaker label. -->
    <Style Selector="Border.user-pill">
      <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- Assistant message: no frame at all, plain text on the background. -->
    <Style Selector="Border.assistant-msg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="StackPanel.chat-activity">
      <Setter Property="Spacing" Value="7" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.chat-activity-dots">
      <Setter Property="Spacing" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.chat-activity-dot">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="3" />
      <Setter Property="Fill" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.chat-activity-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chat-activity-elapsed">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Per-message action row: hidden until the message row is hovered. -->
    <Style Selector="StackPanel.message-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="Border.message-row:pointerover StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.message-row:pointerover StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.message-row:focus-within StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.message-row:focus-within StackPanel.message-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.message-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Button.message-action.message-action-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.message-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.message-timestamp">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <!-- Neutral notice rows (model changed, cancellation): small icon + one muted line. -->
    <Style Selector="Grid.notice">
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="Grid.notice Path.notice-icon">
      <Setter Property="Fill" Value="{DynamicResource Hub.TextTertiary}" />
    </Style>
    <Style Selector="Grid.notice TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.notice.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.DangerText}" />
    </Style>
    <Style Selector="Grid.notice.danger Path.notice-icon">
      <Setter Property="Fill" Value="{DynamicResource Hub.DangerText}" />
    </Style>

    <Style Selector="Button.scroll-bottom">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>

    <!-- The composer frame. -->
    <Style Selector="Border.composer">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.composer.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <Style Selector="ComboBox.chip">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>
    <Style Selector="ComboBox.composer-choice">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>
    <Style Selector="Button.composer-plus">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.composer-plus:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="WrapPanel.context-attachments">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.context-attachment">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3,4,3" />
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style Selector="TextBlock.context-attachment-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.context-attachment-remove">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="local|ContextUsageRing">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="TrackBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="ProgressBrush" Value="{DynamicResource Hub.Accent}" />
    </Style>
    <Style Selector="Button.send">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <!-- Message area: messages flow directly on the background, centered 820px column. -->
    <Grid Grid.Row="0">
      <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="MessageFlow"
                      MaxWidth="820" HorizontalAlignment="Center"
                      Margin="0,16,0,16" Spacing="10" />
        </Grid>
      </ScrollViewer>

      <!-- Empty state: centered greeting without prefilled prompts. -->
      <StackPanel x:Name="EmptyState" IsVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="12" Margin="24">
        <TextBlock x:Name="GreetingLabel"
                   FontSize="19" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="GreetingSubtitle" Classes="muted"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <Button x:Name="ScrollToBottomButton" Classes="scroll-bottom"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
              IsVisible="False" />
    </Grid>

    <!-- Composer: centered to the same column. -->
    <Grid Grid.Row="1">
      <Border x:Name="ComposerFrame" Classes="composer"
              Background="{DynamicResource Hub.SurfaceAlt}" CornerRadius="14"
              HorizontalAlignment="Stretch" MaxWidth="820"
              Margin="0,6,0,4" Padding="14,12,12,10">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <TextBox x:Name="InputBox" Grid.Row="0" AcceptsReturn="True" MinHeight="48" MaxHeight="160"
                   TextWrapping="Wrap" PlaceholderText="{DynamicResource InputPlaceholder}"
                   PlaceholderForeground="{DynamicResource Hub.TextTertiary}"
                   VerticalContentAlignment="Top"
                   Background="Transparent" BorderThickness="0" CornerRadius="0"
                   Padding="2,0" Margin="0" />
          <WrapPanel x:Name="ContextAttachmentPanel" Grid.Row="1" Classes="context-attachments"
                     IsVisible="False" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <WrapPanel x:Name="ComposerChoices" Grid.Column="0" VerticalAlignment="Center">
              <Button x:Name="AddContextButton" Classes="composer-plus" VerticalAlignment="Center"
                      Content="+" />
              <ComboBox x:Name="ModePicker" Classes="composer-choice"
                        Width="92" VerticalAlignment="Center" />
              <ComboBox x:Name="ReasoningPicker" Classes="composer-choice"
                        Width="132" VerticalAlignment="Center" />
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center" Margin="8,0,0,0">
              <ComboBox x:Name="ModelPicker" Classes="chip composer-choice"
                        Width="190" HorizontalAlignment="Left" VerticalAlignment="Center"
                        PlaceholderText="{DynamicResource NoAvailableChatModels}" />
              <local:ContextUsageRing x:Name="ContextRing" VerticalAlignment="Center" />
              <Button x:Name="SendButton" Classes="send" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
