<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AxmolHub.App"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="AxmolHub.App.ChatPanel"
             x:DataType="local:ChatPanel">

  <UserControl.Styles>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Hub.Link}" />
      <Setter Property="HoverForeground" Value="{DynamicResource Hub.LinkHover}" />
      <Setter Property="IsUnderline" Value="True" />
    </Style>
    <Style Selector="Border.CodeBlock">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,10" />
    </Style>
    <Style Selector="ScrollViewer.CodeBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="TextBlock.CodeBlock">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ae|TextEditor.markdown-code-editor">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.markdown-code-copy">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Path Width="15"
                  Height="15"
                  Stretch="Uniform"
                  Data="{StaticResource Hub.Icon.Copy}"
                  Fill="Transparent"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.8" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.markdown-code-copy:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Border.CodeBlock:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <Style Selector="Button.session">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.session:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.session.active">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.session-menu">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.session-row:pointerover Button.session-menu">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.session-menu:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.message-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="Border.message-row:pointerover Button.message-action">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.message-action:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
    <Style Selector="Button.scroll-bottom">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.group-header">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextTertiary}" />
      <Setter Property="Margin" Value="2,10,0,2" />
    </Style>
    <!-- The composer frame. Hub.BorderSubtle in dark mode is #353535, the same value as Hub.SurfaceRaised,
         so a raised frame bordered with it has no visible outline - the frame takes Hub.Border and stays a
         step darker than the chip inside it, which is what makes the chip read as a control. The focused
         variant is toggled from code (see SetComposerFocus) rather than with :focus-within, so it is a real,
         assertable state instead of a selector that may silently never match. -->
    <Style Selector="Border.composer">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.composer.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <!-- The model picker as a chip. The global ComboBox theme (Theme/HubControls.axaml) stays untouched:
         a full-width bordered field is right for the settings page and wrong for a composer. -->
    <Style Selector="ComboBox.chip">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
      <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>
    <!-- The one-round send / stop button. Height, width and radius are set together so it is a circle rather
         than a rounded square. -->
    <Style Selector="Button.send">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="250,*">

    <!-- Session history -->
    <Border Grid.Column="0" Background="{DynamicResource Hub.SurfaceAlt}"
            BorderBrush="{DynamicResource Hub.BorderSubtle}" BorderThickness="0,0,1,0"
            Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10">
          <Button x:Name="NewConversationButton" Content="{DynamicResource NewConversation}"
                  Classes="primary" HorizontalAlignment="Stretch" Padding="10,8" />
          <TextBox x:Name="ConversationSearch" PlaceholderText="{DynamicResource SearchConversations}"
                   PlaceholderForeground="{DynamicResource Hub.TextTertiary}" Padding="9,7" />
          <TextBlock x:Name="ConversationListLabel" Text="{DynamicResource Conversation}"
                     Classes="muted" FontSize="11" Margin="2,5,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel x:Name="ConversationList" Spacing="3" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Active conversation -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="24,20,24,16">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleLabel" Text="{DynamicResource Assistant}"
                     FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ActiveModelLabel" Classes="muted" FontSize="12" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource Hub.SurfaceSunken}" CornerRadius="6"
              BorderBrush="{DynamicResource Hub.BorderSubtle}" BorderThickness="1">
        <Grid>
          <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel x:Name="MessageFlow" Spacing="12" />
          </ScrollViewer>
          <TextBlock x:Name="EmptyHint" Text="{DynamicResource AssistantEmpty}"
                     Classes="muted" TextWrapping="Wrap" Margin="20,16"
                     VerticalAlignment="Top" IsVisible="False" />
          <Button x:Name="ScrollToBottomButton" Classes="scroll-bottom"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                  IsVisible="False" />
        </Grid>
      </Border>

      <!-- Composer: one rounded container drawing the only frame, so the composer reads as a single control
           instead of three stacked boxes. The input is borderless; the model picker is a chip rather than a
           full-width field because switching models is a low-frequency action that should not out-weigh the
           message being typed. The send button is a round icon button whose two states (arrow / square) are
           distinguishable by shape, not only by colour. -->
      <Border x:Name="ComposerFrame" Grid.Row="2" Classes="composer"
              Background="{DynamicResource Hub.SurfaceAlt}" CornerRadius="14"
              Margin="0,12,0,0" Padding="14,12,12,10">
        <Grid RowDefinitions="Auto,Auto">
          <TextBox x:Name="InputBox" Grid.Row="0" AcceptsReturn="True" MinHeight="52" MaxHeight="160"
                   TextWrapping="Wrap" PlaceholderText="{DynamicResource InputPlaceholder}"
                   PlaceholderForeground="{DynamicResource Hub.TextTertiary}"
                   VerticalContentAlignment="Top"
                   Background="Transparent" BorderThickness="0" CornerRadius="0"
                   Padding="2,0" Margin="0" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <ComboBox x:Name="ModelPicker" Grid.Column="0" Classes="chip"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      PlaceholderText="{DynamicResource NoAvailableChatModels}" />
            <Button x:Name="SendButton" Grid.Column="1" Classes="send" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
