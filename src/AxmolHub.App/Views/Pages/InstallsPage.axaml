<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AxmolHub.Core"
             xmlns:local="using:AxmolHub.App"
             x:Class="AxmolHub.App.InstallsPage"
             x:DataType="local:InstallsPage">

  <!--
    Engines page. The WPF version called it InstallsPage (the nav text Key is likewise "Installs"), and the
    same name is kept here. Structure copied verbatim: title row → engine table → seven action buttons.
  -->

  <UserControl.Styles>
    <!-- Same rule as the projects page action bar: the theme puts Margin 0,0,8,0 on every Button, so
         the bar zeroes it and lets ItemSpacing/LineSpacing own both gaps (a wrapped second line had
         none before, which read as cramped). -->
    <Style Selector="WrapPanel.actions > Button">
      <Setter Property="Margin" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ImportButton" Content="{DynamicResource ImportEngine}" Classes="quiet" />
        <Button x:Name="InstallButton" Content="{DynamicResource InstallOfficial}"
                Classes="primary" Margin="8,0,0,0" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{DynamicResource Installs}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource EnginesHint}" Classes="muted" Margin="0,8,12,0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Hub.Border}"
            BorderThickness="1" CornerRadius="7">
      <Grid>
        <DataGrid x:Name="EnginesGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Version}" Width="100" x:DataType="core:EngineEntry" />
            <DataGridTextColumn Binding="{Binding Channel}" Width="140" x:DataType="core:EngineEntry" />
            <DataGridTextColumn Binding="{Binding Path}" Width="*" x:DataType="core:EngineEntry" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyEngines" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </Border>

    <!-- Two status readouts above the action bar: the engine's dependency mirror (which the user can
         change here) and the prebuilt-library state that projects align to. -->
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="MirrorStatus" Classes="muted" TextWrapping="Wrap" />
      <TextBlock x:Name="PrebuiltStatus" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <WrapPanel Grid.Row="3" Classes="actions" ItemSpacing="8" LineSpacing="8" Margin="0,18,0,6">
      <Button x:Name="MirrorButton" Content="{DynamicResource SwitchMirror}" />
      <Button x:Name="BuildEngineButton" Content="{DynamicResource BuildEngine}" />
      <Button x:Name="DefaultButton" Content="{DynamicResource SetDefault}" />
      <Button x:Name="OpenFolderButton" Content="{DynamicResource OpenFolder}" Classes="quiet" />
      <Button x:Name="VerifyButton" Content="{DynamicResource VerifyEngine}" Classes="quiet" />
      <Button x:Name="RepairButton" Content="{DynamicResource Repair}" Classes="quiet" />
      <Button x:Name="UninstallButton" Content="{DynamicResource Uninstall}" Classes="quiet" />
      <Button x:Name="RemoveButton" Content="{DynamicResource RemoveFromList}" Classes="quiet" />
    </WrapPanel>

  </Grid>
</UserControl>
