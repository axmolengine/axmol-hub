<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Avalonia equivalents of the full set of ControlTemplates from the WPF version's App.xaml.

    Two semantic differences to keep in mind (see docs/avalonia-migration-plan.md §3.1):

    1. Avalonia has no Trigger. WPF's `<Trigger Property="IsMouseOver"> + Setter TargetName="Frame"`
       becomes here "selector + pseudo-class + /template/ to target a template-internal part":
         Button:pointerover /template/ Border#Frame
       The pseudo-class names changed too: IsMouseOver→:pointerover, IsKeyboardFocused→:focus,
       IsEnabled=False→:disabled, IsChecked→:checked, IsHighlighted→:pointerover,
       IsExpanded→:expanded, IsSelected→:selected.
    2. WPF's `FocusVisualStyle="{x:Null}"` corresponds to Avalonia's `FocusAdorner="{x:Null}"`.

    Here we use ControlTheme (x:Key as {x:Type T}) instead of a plain Style: ControlTheme **replaces**
    the entire template of the same-named control in the Fluent theme, consistent with the WPF
    version's "write full templates ourselves" approach; class styles (Button.primary and the like)
    are layered on in HubStyles.axaml.
  -->

  <!-- ==================== Button ==================== -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="^:focus /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <!-- The WPF version had no pressed state: after replacing the whole template, pressed looked exactly like normal. Here we add one. -->
    <Style Selector="^:pressed /template/ Border#Frame">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Frame">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <!-- ==================== TextBox ====================
       PasswordBox does not exist in Avalonia: a password box is just a TextBox with PasswordChar,
       so that WPF style does not need a separate rewrite; see TextBox.password in HubStyles.axaml. -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="CaretBrush" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Hub.Accent}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Hub.TextOnAccent}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <!-- Note: Avalonia 12's TextBox **no longer** uses WPF's ScrollViewer#PART_ContentHost;
                 the required part is a TextPresenter#PART_TextPresenter (missing it fails to compile, AVLN2205).
                 The template structure is trimmed from the official Fluent theme down to the minimal set Hub actually uses:
                 it omits InnerLeftContent / InnerRightContent / the floating placeholder.
                 Also: Avalonia 12 renamed Watermark to PlaceholderText. -->
            <ScrollViewer Name="PART_ScrollViewer"
                          Margin="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
              <Panel>
                <TextBlock Name="PART_Placeholder"
                           Foreground="{TemplateBinding PlaceholderForeground}"
                           Text="{TemplateBinding PlaceholderText}"
                           TextAlignment="{TemplateBinding TextAlignment}"
                           TextWrapping="{TemplateBinding TextWrapping}"
                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                      <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <TextPresenter Name="PART_TextPresenter"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}"
                               LineHeight="{TemplateBinding LineHeight}"
                               LetterSpacing="{TemplateBinding LetterSpacing}"
                               PasswordChar="{TemplateBinding PasswordChar}"
                               RevealPassword="{TemplateBinding RevealPassword}"
                               SelectionBrush="{TemplateBinding SelectionBrush}"
                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
              <ScrollViewer.Styles>
                <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                  <Setter Property="Cursor" Value="IBeam" />
                </Style>
              </ScrollViewer.Styles>
            </ScrollViewer>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Frame">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </ControlTheme>

  <!-- ==================== ComboBoxItem ==================== -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame"
                Background="{DynamicResource Hub.PopupSurface}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSelected}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSelected}" />
    </Style>
  </ControlTheme>

  <!-- ==================== ComboBox ====================
       Template structure adapted from Avalonia's official Fluent theme. Parts that must be kept:
         PART_Popup (the dropdown host, IsLightDismissEnabled), PART_ItemsPresenter,
         and the SelectionBoxItem / SelectionBoxItemTemplate bindings in the content area. -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="MaxDropDownHeight" Value="260" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,32">
            <Border Name="Frame"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentControl Name="SelectionPresenter"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsHitTestVisible="False" />
            <Path Name="DropDownGlyph"
                  Grid.Column="1"
                  Width="11" Height="11"
                  Margin="0,0,11,0"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Stretch="Uniform"
                  IsHitTestVisible="False"
                  Fill="{DynamicResource Hub.TextSecondary}"
                  Data="{StaticResource Hub.Icon.Chevron}" />
            <Popup Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   PlacementTarget="Frame"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   WindowManagerAddShadowHint="False"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Name="PopupBorder"
                      Background="{DynamicResource Hub.PopupSurface}"
                      BorderBrush="{DynamicResource Hub.BorderStrong}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="0">
                <ScrollViewer IsScrollChainingEnabled="False"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <Style Selector="^:focus /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderFocus}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </ControlTheme>

  <!-- ==================== CheckBox ==================== -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Name="Box"
                  Width="20" Height="20"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Hub.CheckBoxFill}"
                  BorderBrush="{DynamicResource Hub.CheckBoxBorder}"
                  BorderThickness="1"
                  CornerRadius="4">
            <!-- WPF used the font glyph "✓" (a Segoe UI private-use glyph? no, an ordinary character);
                 switching to a vector path no longer depends on any font's glyph coverage. -->
            <Path Name="Tick"
                  Width="12" Height="12"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stretch="Uniform"
                  IsVisible="False"
                  Fill="{DynamicResource Hub.CheckMark}"
                  Data="{StaticResource Hub.Icon.Tick}" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource Hub.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentSoftBorder}" />
    </Style>
    <Style Selector="^:checked /template/ Path#Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
  </ControlTheme>

  <!-- ==================== RadioButton ==================== -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Padding" Value="15,13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame"
                Background="Transparent"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSelected}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
  </ControlTheme>

  <!-- ==================== Expander header ====================
       A separate ControlTheme so that "swap the arrow when expanded" can be expressed with the standard
       `^:checked /template/ ...` selector — if it were written inside Expander's own template,
       two levels of /template/ would be needed to reach inside the ToggleButton template. -->
  <ControlTheme x:Key="HubExpanderHeader" TargetType="ToggleButton">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="HeaderFrame" Background="Transparent" Padding="2,4">
          <DockPanel>
            <Path Name="Arrow"
                  Width="10" Height="10"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Fill="{DynamicResource Hub.TextSecondary}"
                  Data="{StaticResource Hub.Icon.ChevronRight}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- WPF swapped the glyph (› → ⌄); here the same path is rotated 90°. -->
    <Style Selector="^:checked /template/ Path#Arrow">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    </Style>
  </ControlTheme>

  <!-- ==================== Expander ==================== -->
  <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ToggleButton Name="ExpanderHeader"
                        DockPanel.Dock="Top"
                        Theme="{StaticResource HubExpanderHeader}"
                        IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        Foreground="{TemplateBinding Foreground}"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}" />
          <Border Name="ExpanderBody"
                  IsVisible="{TemplateBinding IsExpanded}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ==================== ScrollBar thumb ====================
       Same reasoning as the Expander header: a separate ControlTheme lets the hover state be expressed with a single-level selector. -->
  <ControlTheme x:Key="HubScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bar" Background="{DynamicResource Hub.ScrollThumb}" CornerRadius="4" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Bar">
      <Setter Property="Background" Value="{DynamicResource Hub.ScrollThumbHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Bar">
      <Setter Property="Background" Value="{DynamicResource Hub.ScrollThumbHover}" />
    </Style>
  </ControlTheme>

  <!-- ==================== ScrollBar ====================
       The WPF version was a fixed, always-visible 10px bar. Avalonia's Fluent default is a floating,
       auto-hiding thin bar; here it is replaced entirely to keep the always-visible look of the WPF version.
       Parts: Track#PART_Track needs Minimum/Maximum/Value/ViewportSize/Orientation;
       Thumb hangs directly off Track.Thumb. Track's DecreaseButton/IncreaseButton are
       nullable properties (verified against Track.cs in Avalonia 12.1.3), and the WPF version had no
       paging buttons either, so they are omitted as well. -->
  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Hub.ScrollTrack}" />
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" Background="{TemplateBinding Background}">
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Name="PART_Thumb"
                       Theme="{StaticResource HubScrollThumb}"
                       HorizontalAlignment="Stretch"
                       Margin="2" />
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="10" />
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" Background="{TemplateBinding Background}">
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}">
              <Track.Thumb>
                <Thumb Name="PART_Thumb"
                       Theme="{StaticResource HubScrollThumb}"
                       VerticalAlignment="Stretch"
                       Margin="2" />
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

</ResourceDictionary>
