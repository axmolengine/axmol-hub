<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Semantic color vocabulary. The WPF version scattered these values as literals across the 18
    ControlTemplates in App.xaml (#1E1E1E / #E4E4E4 / #A8A8A8 …), with the same meaning written as
    different near-matching colors in different controls. Here each meaning appears exactly once;
    the control layer only references names, never writes literals.

    Theme variants are expressed with ThemeDictionaries: which variant the app runs under is decided
    by RequestedThemeVariant, and switching variants at runtime makes all DynamicResource references
    re-resolve automatically. The WPF version only had the dark theme.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">

      <SolidColorBrush x:Key="Hub.Background" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Hub.Surface" Color="#292929" />
      <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#242424" />
      <SolidColorBrush x:Key="Hub.SurfaceRaised" Color="#353535" />
      <SolidColorBrush x:Key="Hub.SurfaceSunken" Color="#202020" />
      <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#343434" />
      <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#383838" />
      <SolidColorBrush x:Key="Hub.PopupSurface" Color="#292929" />

      <SolidColorBrush x:Key="Hub.Border" Color="#3A3A3A" />
      <SolidColorBrush x:Key="Hub.BorderSubtle" Color="#353535" />
      <SolidColorBrush x:Key="Hub.BorderStrong" Color="#4B4B4B" />
      <SolidColorBrush x:Key="Hub.BorderHover" Color="#6AB6EB" />
      <SolidColorBrush x:Key="Hub.BorderFocus" Color="#399BDC" />

      <SolidColorBrush x:Key="Hub.TextPrimary" Color="#E4E4E4" />
      <SolidColorBrush x:Key="Hub.TextSecondary" Color="#A8A8A8" />
      <SolidColorBrush x:Key="Hub.TextTertiary" Color="#888888" />
      <SolidColorBrush x:Key="Hub.TextDisabled" Color="#7A7A7A" />
      <SolidColorBrush x:Key="Hub.TextOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Accent" Color="#2188CF" />
      <SolidColorBrush x:Key="Hub.AccentBorder" Color="#399BDC" />
      <SolidColorBrush x:Key="Hub.AccentSoft" Color="#2879CE" />
      <SolidColorBrush x:Key="Hub.AccentSoftBorder" Color="#398BE0" />

      <SolidColorBrush x:Key="Hub.Success" Color="#70D7AF" />
      <SolidColorBrush x:Key="Hub.Danger" Color="#F294A7" />
      <!-- Danger split in two weights. Hub.Danger is a fill: on a dark page it is a bright block, which is
           why only HubDialog's confirm key uses it. Hub.DangerText is the same hue used as ink, and
           Hub.DangerBorder is that hue mixed into the surface, so a page button can be marked
           consequential without shouting over the action bar's primary button. -->
      <SolidColorBrush x:Key="Hub.DangerText" Color="#F294A7" />
      <SolidColorBrush x:Key="Hub.DangerBorder" Color="#8A5A64" />

      <!-- Notification dot (the "update available" badge on the Settings nav item). Its own semantic
           on purpose: an available update is not a danger/error, so it must not reuse Hub.Danger
           (which is also deliberately low-chroma for ink/fill use). Values are tuned for a small
           *filled* dot — both clear ≥4.5:1 against every surface in their theme, which the pale
           Hub.Danger dark hue would not read as for an alert at 8px. -->
      <SolidColorBrush x:Key="Hub.NotificationDot" Color="#FF5C6C" />

      <SolidColorBrush x:Key="Hub.GridSurface" Color="#252525" />
      <SolidColorBrush x:Key="Hub.GridAlternate" Color="#292929" />
      <SolidColorBrush x:Key="Hub.GridHeader" Color="#2D2D2D" />
      <SolidColorBrush x:Key="Hub.RowHover" Color="#313131" />
      <SolidColorBrush x:Key="Hub.RowSelected" Color="#3B3B3B" />

      <SolidColorBrush x:Key="Hub.ScrollTrack" Color="#202020" />
      <SolidColorBrush x:Key="Hub.ScrollThumb" Color="#575757" />
      <SolidColorBrush x:Key="Hub.ScrollThumbHover" Color="#6E6E6E" />

      <SolidColorBrush x:Key="Hub.CheckBoxFill" Color="#2B2B2B" />
      <SolidColorBrush x:Key="Hub.CheckBoxBorder" Color="#4B4B4B" />
      <SolidColorBrush x:Key="Hub.CheckMark" Color="#FFFFFF" />

    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">

      <!-- Light is not the inverse of dark but a separately chosen set of values: cards are brighter
           than the page (white), and the sidebar is slightly darker than the page, matching the
           light-theme conventions of macOS / Windows. -->
      <SolidColorBrush x:Key="Hub.Background" Color="#F4F5F7" />
      <SolidColorBrush x:Key="Hub.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#EDEEF2" />
      <SolidColorBrush x:Key="Hub.SurfaceRaised" Color="#E9E9EE" />
      <SolidColorBrush x:Key="Hub.SurfaceSunken" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#E4E4EA" />
      <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#DCE4F0" />
      <SolidColorBrush x:Key="Hub.PopupSurface" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Border" Color="#D8D9DF" />
      <SolidColorBrush x:Key="Hub.BorderSubtle" Color="#E4E5EA" />
      <SolidColorBrush x:Key="Hub.BorderStrong" Color="#C3C4CC" />
      <SolidColorBrush x:Key="Hub.BorderHover" Color="#4FA8E8" />
      <SolidColorBrush x:Key="Hub.BorderFocus" Color="#1A73BE" />

      <SolidColorBrush x:Key="Hub.TextPrimary" Color="#1B1C20" />
      <SolidColorBrush x:Key="Hub.TextSecondary" Color="#6A6B75" />
      <SolidColorBrush x:Key="Hub.TextTertiary" Color="#8A8B95" />
      <SolidColorBrush x:Key="Hub.TextDisabled" Color="#A6A7B0" />
      <SolidColorBrush x:Key="Hub.TextOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Accent" Color="#1A73BE" />
      <SolidColorBrush x:Key="Hub.AccentBorder" Color="#2E86C8" />
      <SolidColorBrush x:Key="Hub.AccentSoft" Color="#2E86C8" />
      <SolidColorBrush x:Key="Hub.AccentSoftBorder" Color="#3D93D6" />

      <SolidColorBrush x:Key="Hub.Success" Color="#1E9E76" />
      <SolidColorBrush x:Key="Hub.Danger" Color="#C63A55" />
      <SolidColorBrush x:Key="Hub.DangerText" Color="#C63A55" />
      <SolidColorBrush x:Key="Hub.DangerBorder" Color="#E5A6B2" />

      <!-- See the note in the Dark dictionary: a distinct semantic from Hub.Danger, tuned as a filled dot. -->
      <SolidColorBrush x:Key="Hub.NotificationDot" Color="#D93025" />

      <SolidColorBrush x:Key="Hub.GridSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.GridAlternate" Color="#FAFAFC" />
      <SolidColorBrush x:Key="Hub.GridHeader" Color="#F0F1F4" />
      <SolidColorBrush x:Key="Hub.RowHover" Color="#EFF2F7" />
      <SolidColorBrush x:Key="Hub.RowSelected" Color="#DCE8F5" />

      <SolidColorBrush x:Key="Hub.ScrollTrack" Color="#EFEFF2" />
      <SolidColorBrush x:Key="Hub.ScrollThumb" Color="#B9BAC2" />
      <SolidColorBrush x:Key="Hub.ScrollThumbHover" Color="#9A9BA4" />

      <SolidColorBrush x:Key="Hub.CheckBoxFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.CheckBoxBorder" Color="#B9BAC4" />
      <SolidColorBrush x:Key="Hub.CheckMark" Color="#FFFFFF" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
