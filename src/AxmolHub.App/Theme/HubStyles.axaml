<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The Avalonia counterpart of WPF's x:Key-named styles (Muted / Card / Primary / Quiet) is the
    **style class**: controls carry Classes="muted" / "card" / "primary" / "quiet".
    Class styles layer on top of ControlTheme, so WPF's
    `BasedOn="{StaticResource {x:Type Button}}"` is no longer needed — both styles take effect.

    The other part of this file is the template-less styles moved over from App.xaml
    (the DataGrid family's property settings).
  -->

  <Styles.Resources>

    <!-- Font fallback chain. The WPF version hard-coded "Segoe UI, Microsoft YaHei UI"; on macOS / Linux
         the first of these does not exist, so Chinese fell back to whatever the system provides. Here we
         give one common font per platform, all ranked before the generic family. -->
    <FontFamily x:Key="Hub.Font.Ui">Segoe UI, Microsoft YaHei UI, PingFang SC, Hiragino Sans GB, Source Han Sans SC, Noto Sans CJK SC, DejaVu Sans, sans-serif</FontFamily>
    <FontFamily x:Key="Hub.Font.Mono">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, Noto Sans Mono CJK SC, monospace</FontFamily>

  </Styles.Resources>

  <!-- ==================== Window and body text ==================== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Hub.Font.Ui}" />
    <Setter Property="Background" Value="{DynamicResource Hub.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>

  <!-- The WPF version's TextBlock default style (foreground + vertical centering) is kept as-is here.
         Note this is global: its foreground overrides colors inherited from the parent, matching WPF's behavior. -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- WPF's Style x:Key="Muted" -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Monospace font for the activity log (WPF inlined FontFamily="Consolas") -->
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource Hub.Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ==================== Containers ==================== -->
  <!-- WPF's Style x:Key="Card" -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- ==================== Button variants ==================== -->
  <!-- WPF's Style x:Key="Primary" -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Hub.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentBorder}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- WPF's Style x:Key="Quiet" -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
  </Style>

  <!-- Added in P4. The WPF version had no "dangerous action" button variant: there MessageBoxImage.Warning/Error
       only swapped the icon, and the confirm button of uninstall / delete confirmation dialogs looked exactly
       like a normal confirm button. HubDialog adds this tier as a button variant. -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Hub.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Danger}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ==================== Inputs ==================== -->
  <!-- The WPF PasswordBox style. Avalonia has no PasswordBox: password box = TextBox + PasswordChar,
         so this is just a class, not a template. -->
  <Style Selector="TextBox.password">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
  </Style>

  <!-- ==================== DataGrid family ====================
       The WPF version wrote one style each for DataGrid / DataGridColumnHeader / DataGridCell / DataGridRow
       in App.xaml. Here we only override properties and state colors, **without replacing DataGrid's own template**:
       DataGrid's cell/row template parts cover more than a hand-written template could, and stability matters
       even more for the 35 references migrated in P5.

       Differences from WPF (Avalonia's DataGrid has no corresponding property, so they cannot be ported verbatim):
         RowHeight / ColumnHeaderHeight → use the row's MinHeight instead (see below)
         AlternatingRowBackground (zebra rows) → no corresponding property, missing for now
         SelectionUnit / CanUserResizeRows → no corresponding property; default behavior is already close -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Hub.GridSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="RowBackground" Value="{DynamicResource Hub.GridSurface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Hub.GridHeader}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <!-- WPF's `FocusVisualStyle="{x:Null}"` is FocusAdorner in Avalonia. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="56" />
  </Style>

  <!-- Hover and selection are both painted on Rectangle#BackgroundRectangle in the row template
       (verified against Avalonia's DataGrid Fluent theme), so /template/ is used to target that part,
       and the theme-provided opacity is explicitly overridden. -->
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Hub.RowHover}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Hub.RowSelected}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

</Styles>
