<Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2188CF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#399BDC"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
