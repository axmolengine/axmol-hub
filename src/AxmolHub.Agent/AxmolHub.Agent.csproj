<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 与 Core / Cli 的 net8.0 对齐，不升 TFM。 -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Version 见仓库根的 Directory.Build.props：五个项目共用一个产品版本。 -->
    <!-- RestorePackagesWithLockFile 继承根 props 的 true：本项目是仓库第二个引入
         PackageReference 的项目（第一个是 App），锁文件须跟踪。 -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AxmolHub.Core/AxmolHub.Core.csproj" />
    <!-- AI 能力层依赖只进 Agent：Core / Cli 保持零依赖、可离线冷构建。 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <!-- Windows 专属（DPAPI）；macOS Keychain / Linux Secret Service 走 P/Invoke，无需包。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
</Project>
