<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Aligned with Core / Cli on net8.0; the TFM is not upgraded. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Version: see Directory.Build.props at the repo root — the five projects share one product version. -->
    <!-- Opted out and untracked. This is common code: both App and Checks reference it and it is never
         shipped on its own, and NuGet is explicit that a common code project's lock file has "little say
         over the packages resolved for projects that depend on it". Measured before deleting the file: all
         24 package entries it carried already sit in the App lock file at identical resolved versions,
         alongside an axmolhub.agent project entry that records the three direct ranges below. So it pinned
         nothing and only churned — every RID publish of App rewrote it, and commit c4564e9 bolted a stray
         net8.0/win-x64 node onto it in the middle of an installer change.
         One NuGet quirk outlives this comment: a packages.lock.json sitting in this directory is used by
         restore even with this property set to false, and .gitignore keeps such a leftover out of
         git status. If one reappears here, delete it. The policy and its reasoning are in the repo-root
         Directory.Build.props. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AxmolHub.Checks" />
    <InternalsVisibleTo Include="AxmolHub" />
    <ProjectReference Include="../AxmolHub.Core/AxmolHub.Core.csproj" />
    <!-- AI capability-layer dependencies go into Agent only: Core / Cli stay dependency-free and can cold-build offline. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <!-- Windows-specific (DPAPI); macOS Keychain / Linux Secret Service use P/Invoke and need no package.
         Held at 10.0.15 instead of 11.0.0 on purpose. 11.0.0 dropped its net8.0 group, so a net8.0 target
         falls back to its netstandard2.0 assets and drags System.Memory 4.6.3 along — one more assembly in
         every publish RID and one more entry in licenses/PackageLicenses.txt, bought for nothing: the surface
         is the same three calls over the same Windows DPAPI, and nothing here uses Span. 10.0.15 is the
         exact-match net8.0 asset with no dependencies, and it is the same 10.0.15 servicing band that the
         Microsoft.Extensions.AI 11 upgrade already pulled the System.* packages up to. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
</Project>
