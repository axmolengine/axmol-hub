<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Aligned with Core / Cli on net8.0; the TFM is not upgraded. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Version: see Directory.Build.props at the repo root — the five projects share one product version. -->
    <!-- RestorePackagesWithLockFile inherits true from the root props: this is the repo's second
         project to introduce a PackageReference (the first is App), so the lock file must be tracked. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AxmolHub.Core/AxmolHub.Core.csproj" />
    <!-- AI capability-layer dependencies go into Agent only: Core / Cli stay dependency-free and can cold-build offline. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <!-- Windows-specific (DPAPI); macOS Keychain / Linux Secret Service use P/Invoke and need no package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
</Project>
