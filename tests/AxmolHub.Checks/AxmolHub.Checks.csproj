<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Opted out and untracked. This project declares no PackageReference of its own: its lock file held
         23 package entries and not one of them Direct, every version arriving through Agent, and Checks
         ships nothing to anybody. A lock with no direct dependency has no say over any build, so it joins
         Core and Cli in the opt-out rather than following the App rule. Re-decide by the policy in the
         repo-root Directory.Build.props if this project ever gains its own PackageReference, and delete a
         leftover packages.lock.json before re-enabling it: NuGet consumes a lock file that exists even
         while this property says false. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AxmolHub.Core/AxmolHub.Core.csproj" />
    <ProjectReference Include="../../src/AxmolHub.Agent/AxmolHub.Agent.csproj" />
  </ItemGroup>
  <!-- Same deployment layout as the three exe projects: PackagingRecipes reads the verification
       boundary from AppContext.BaseDirectory/manifests, and the behaviour checks must see the very
       manifests the product sees, otherwise the assertions never test the real code path. -->
  <ItemGroup>
    <Content Include="../../manifests/*.json" Link="manifests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../manifests/*.xml" Link="manifests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Provider response samples trimmed from real captures. They live in the output directory
         instead of being read through a repo-relative path, because the assertions must be able to
         run the compiled exe in CI: once cwd changes, "tests/..." becomes a file nobody can find, and
         an assertion that cannot read its sample is worse than a failing one — it goes green. -->
    <Content Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
